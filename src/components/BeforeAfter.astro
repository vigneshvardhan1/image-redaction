---
import type { Locale } from '../i18n/config';
import { DEFAULT_LOCALE } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  class?: string;
  locale?: Locale;
}

const { class: className = '', locale = DEFAULT_LOCALE } = Astro.props;
const beforeLabel = t(locale, 'demo.before');
const afterLabel = t(locale, 'demo.after');
const compareAria = t(locale, 'demo.compareAria');
const originalAlt = t(locale, 'demo.idOriginalAlt');
const redactedAlt = t(locale, 'demo.idRedactedAlt');
---

<div
  class:list={['data-compare-root', className]}
  data-compare-root
  data-before-label={beforeLabel}
  data-after-label={afterLabel}
>
  <div
    class="relative aspect-[3/2] overflow-hidden rounded-tile border border-hairline bg-canvas-soft has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-ink"
  >
    <img
      src="/samples/id.svg"
      width="1200"
      height="800"
      alt={originalAlt}
      class="absolute inset-0 h-full w-full object-cover"
      decoding="async"
    />
    <div data-after class="absolute inset-0" style="clip-path: inset(0 0 0 50%)">
      <img
        src="/samples/id-redacted.svg"
        width="1200"
        height="800"
        alt={redactedAlt}
        class="absolute inset-0 h-full w-full object-cover"
        decoding="async"
      />
    </div>

    <div
      data-handle
      class="pointer-events-none absolute inset-y-0 z-20 w-px bg-white"
      style="left:50%"
      aria-hidden="true"
    >
      <span class="absolute left-1/2 top-1/2 grid h-10 w-10 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border border-hairline bg-canvas text-ink">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 7 4 12l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          <path d="m15 7 5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>

    <span class="absolute left-3 top-3 z-20 rounded-full bg-black/55 px-2.5 py-1 text-[10px] font-heading text-white backdrop-blur-sm">
      {beforeLabel}
    </span>
    <span class="absolute right-3 top-3 z-20 rounded-full bg-black/55 px-2.5 py-1 text-[10px] font-heading text-white backdrop-blur-sm">
      {afterLabel}
    </span>

    <input
      data-compare
      type="range"
      min="0"
      max="100"
      value="50"
      step="1"
      class="absolute inset-0 z-30 h-full w-full cursor-ew-resize opacity-0"
      aria-label={compareAria}
    />
  </div>
  <p class="mt-3 flex items-center justify-between gap-3 px-1 text-[11px] text-muted">
    <span>{t(locale, 'demo.dragHandle')}</span>
    <span class="inline-flex items-center gap-1.5 text-faint">
      <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
      {t(locale, 'demo.flattened')}
    </span>
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-compare-root]').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('[data-compare]');
    const after = root.querySelector<HTMLElement>('[data-after]');
    const handle = root.querySelector<HTMLElement>('[data-handle]');
    if (!range || !after || !handle) return;

    const beforeLabel = root.dataset.beforeLabel ?? 'original';
    const afterLabel = root.dataset.afterLabel ?? 'redacted';

    const update = () => {
      const value = Number(range.value);
      after.style.clipPath = `inset(0 0 0 ${value}%)`;
      handle.style.left = `${value}%`;
      range.setAttribute(
        'aria-valuetext',
        `${value}% ${beforeLabel}, ${100 - value}% ${afterLabel}`,
      );
    };

    range.addEventListener('input', update);
    update();
  });
</script>
