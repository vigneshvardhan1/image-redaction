---
interface Props {
  eyebrow?: string;
  title: string;
  copy?: string;
  align?: 'left' | 'center';
  id?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  copy,
  align = 'left',
  id,
  class: className = '',
} = Astro.props;

const hasActions = Astro.slots.has('actions');
---

<div
  class:list={[
    'flex flex-col gap-6',
    hasActions && 'md:flex-row md:items-end md:justify-between md:gap-10',
    className,
  ]}
>
  <div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
    {
      eyebrow && (
        <p
          class:list={[
            'mb-3 flex items-center gap-2 text-[12px] font-heading leading-none text-muted',
            align === 'center' && 'justify-center',
          ]}
        >
          <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
          {eyebrow}
        </p>
      )
    }
    <h2 id={id} class="text-h2">{title}</h2>
    {
      copy && (
        <p
          class:list={[
            'mt-4 text-[16px] leading-relaxed text-muted',
            align === 'center' ? 'mx-auto max-w-2xl' : 'max-w-xl',
          ]}
        >
          {copy}
        </p>
      )
    }
  </div>

  {
    hasActions && (
      <div class:list={['shrink-0', align === 'center' && 'mx-auto']}>
        <slot name="actions" />
      </div>
    )
  }
</div>
