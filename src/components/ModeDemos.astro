---
import Icon from './Icon.astro';
import type { Locale } from '../i18n/config';
import { getRedactionModes } from '../i18n/content/redactionModes';
import { t } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en-US' } = Astro.props;
const modes = getRedactionModes(locale);
---

<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
  {
    modes.map((mode) => (
      <article class="overflow-hidden rounded-card border border-hairline-soft bg-canvas">
        <div class="relative aspect-[8/5] overflow-hidden bg-canvas-soft">
          <canvas
            data-mode-demo={mode.id}
            width="800"
            height="500"
            class="h-full w-full"
            aria-label={mode.alt}
            role="img"
          ></canvas>
          <span class="absolute right-2.5 top-2.5 rounded-full bg-white/90 px-2 py-0.5 text-[10px] font-heading text-overlay-ink backdrop-blur-sm">
            {mode.badge}
          </span>
        </div>
        <div class="p-4">
          <div class="flex items-center gap-2">
            <span class="grid h-7 w-7 place-items-center rounded-full bg-canvas-soft text-ink">
              <Icon name={mode.icon as any} size={14} />
            </span>
            <h3 class="text-[15px] font-heading">{mode.title}</h3>
          </div>
          <p class="mt-2 text-[12px] leading-relaxed text-muted">{mode.copy}</p>
          <button
            type="button"
            data-tour-jump={mode.id}
            class="mt-3 inline-flex items-center gap-1.5 text-[11px] font-heading text-ink hover:underline"
          >
            {t(locale, 'demo.seeSample')}
            <Icon name="arrow-up-right" size={11} />
          </button>
        </div>
      </article>
    ))
  }
</div>

<p class="mt-4 flex items-start gap-2 text-[11px] leading-relaxed text-muted">
  <Icon name="info" size={13} class="mt-0.5 shrink-0" />
  <span>{t(locale, 'demo.warning')}</span>
</p>

<script>
  import '../scripts/mode-demos';
</script>
