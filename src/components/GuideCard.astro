---
import Icon from './Icon.astro';
import type { Guide } from '../data/guides';
import type { Locale } from '../i18n/config';
import { localizePath } from '../i18n/config';

interface Props {
  guide: Guide;
  class?: string;
  locale?: Locale;
  readLabel?: string;
}

const { guide, class: className = '', locale = 'en-US', readLabel = 'Read guide' } = Astro.props;
const href = localizePath(locale, `/guides/${guide.slug}`);
---

<article
  class:list={[
    'group flex h-full flex-col overflow-hidden rounded-card border border-hairline-soft bg-canvas transition-colors hover:border-hairline',
    className,
  ]}
>
  <a href={href} class="flex h-full flex-col">
    <div class="aspect-[16/10] overflow-hidden border-b border-hairline-soft bg-canvas-soft">
      <img
        src={guide.cover}
        width="1200"
        height="750"
        alt={guide.coverAlt}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.025]"
      />
    </div>
    <div class="flex flex-1 flex-col p-5">
      <p class="flex items-center gap-2 text-[11px] leading-none text-muted">
        <span>{guide.category}</span>
        <span class="text-faint" aria-hidden="true">·</span>
        <span>{guide.readingTime}</span>
      </p>
      <h3 class="mt-3 text-[20px] leading-[1.2]">{guide.title}</h3>
      <p class="mt-2 text-[13px] leading-relaxed text-muted">{guide.description}</p>
      <span class="mt-auto inline-flex items-center gap-1.5 pt-5 text-[12px] font-heading text-ink">
        {readLabel}
        <Icon
          name="arrow-up-right"
          size={13}
          class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </span>
    </div>
  </a>
</article>
