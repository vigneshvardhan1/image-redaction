---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="mt-20 px-2 pb-2 md:mt-28 md:px-3 md:pb-3">
  <div class="rounded-t-card bg-ink px-0 pb-6 pt-14 text-on-ink md:rounded-[2rem] md:pb-8 md:pt-20">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
        <div class="max-w-xl">
          <Logo variant="light" size="md" />
          <p class="mt-6 text-[clamp(2rem,5vw,3.4rem)] font-heading leading-[1.02] text-on-ink">
            Share the screenshot.<br />Not the secrets.
          </p>
          <p class="mt-5 max-w-md text-[15px] leading-relaxed text-on-ink/55">
            A browser-based redaction studio for screenshots, IDs, receipts, and anything else
            you'd rather not hand over in full.
          </p>
          <div class="mt-7 inline-flex items-center gap-2 rounded-full border border-on-ink/15 px-3 py-2 text-[12px] text-on-ink/65">
            <Icon name="lock" size={12} class="text-on-ink/50" />
            Processing stays on your device
          </div>
        </div>

        <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:justify-items-end">
          <div>
            <h2 class="text-[12px] font-heading text-on-ink/40">Product</h2>
            <ul class="mt-4 space-y-3 text-[14px]">
              <li><a href="/#editor" class="text-on-ink/70 transition-colors hover:text-on-ink">Editor</a></li>
              <li><a href="/features" class="text-on-ink/70 transition-colors hover:text-on-ink">Features</a></li>
              <li><a href="/#compare" class="text-on-ink/70 transition-colors hover:text-on-ink">Compare</a></li>
              <li><a href="/privacy" class="text-on-ink/70 transition-colors hover:text-on-ink">Privacy</a></li>
            </ul>
          </div>
          <div>
            <h2 class="text-[12px] font-heading text-on-ink/40">Resources</h2>
            <ul class="mt-4 space-y-3 text-[14px]">
              <li><a href="/guides" class="text-on-ink/70 transition-colors hover:text-on-ink">Guides</a></li>
              <li><a href="/#how-it-works" class="text-on-ink/70 transition-colors hover:text-on-ink">How it works</a></li>
              <li><a href="/#faq" class="text-on-ink/70 transition-colors hover:text-on-ink">FAQ</a></li>
              <li><a href="/features#shortcuts" class="text-on-ink/70 transition-colors hover:text-on-ink">Shortcuts</a></li>
            </ul>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <h2 class="text-[12px] font-heading text-on-ink/40">Contact</h2>
            <ul class="mt-4 space-y-3 text-[14px]">
              <li>
                <a href="mailto:hello@imageredaction.com" class="inline-flex items-center gap-1.5 text-on-ink/70 transition-colors hover:text-on-ink">
                  Email us
                  <Icon name="arrow-up-right" size={13} />
                </a>
              </li>
              <li><a href="/privacy#verify" class="text-on-ink/70 transition-colors hover:text-on-ink">Verify our claims</a></li>
            </ul>
          </div>
        </div>
      </div>

      <div class="mt-14 flex flex-col gap-4 border-t border-on-ink/10 pt-6 text-[12px] text-on-ink/40 md:mt-20 md:flex-row md:items-center md:justify-between">
        <p>© {year} Redact · imageredaction.com</p>
        <p class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <span>No tracking cookies.</span>
          <span>No trackers.</span>
          <span>No uploads.</span>
          <a href="#" class="inline-flex items-center gap-1 text-on-ink/60 transition-colors hover:text-on-ink">
            Back to top
            <Icon name="arrow-up-right" size={12} class="-rotate-45" />
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>
