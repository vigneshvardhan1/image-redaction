---
import Icon from './Icon.astro';

const samples = [
  {
    src: '/samples/id-redacted.svg',
    name: 'Student ID',
    label: 'ID card',
  },
  {
    src: '/samples/chat-redacted.svg',
    name: 'Chat screenshot',
    label: 'Chat',
  },
  {
    src: '/samples/receipt-redacted.svg',
    name: 'Receipt',
    label: 'Receipt',
  },
  {
    src: '/samples/dashboard-redacted.svg',
    name: 'Dashboard',
    label: 'Dashboard',
  },
];
---

<section id="unredact" class="scroll-mt-24" data-unredactor>
  <div class="overflow-hidden rounded-card border border-hairline bg-canvas">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-hairline-soft px-3 py-2.5 md:px-4">
      <div class="flex min-w-0 items-center gap-2">
        <Icon name="eraser" size={12} class="shrink-0 text-muted" />
        <span class="text-[11px] font-heading leading-none">On-device unredactor</span>
        <span class="text-[11px] leading-none text-faint" aria-hidden="true">/</span>
        <span data-ufilename class="max-w-[150px] truncate text-[11px] leading-none text-muted sm:max-w-[260px]">
          No image open
        </span>
        <span data-uimage-size class="hidden text-[11px] leading-none text-faint sm:inline"></span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-canvas-soft px-2.5 py-1 text-[10px] leading-none text-muted">
          <Icon name="lock" size={11} />
          0 bytes uploaded
        </span>
      </div>
    </div>

    <div data-udropzone class="p-3 transition-shadow md:p-4">
      <div class="rounded-tile border border-dashed border-hairline bg-canvas-soft/60 px-5 py-10 md:px-8 md:py-12">
        <div class="mx-auto max-w-2xl text-center">
          <div class="relative mx-auto grid h-16 w-16 place-items-center rounded-[20px] border border-hairline-soft bg-canvas text-ink">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.4" />
              <path d="M7 9h10M7 13h6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
              <path d="m14.5 17.5 3-3 3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>

          <h2 class="mt-6 text-[clamp(1.5rem,3vw,2rem)] leading-[1.1]">
            Drop a redacted image. See what the bar left behind.
          </h2>
          <p class="mx-auto mt-3 max-w-xl text-[14px] leading-relaxed text-muted">
            The unredactor finds solid bars on your device and rebuilds the covered area from the
            pixels around it. Opaque redaction destroys the content underneath, so this is a repair —
            not a recovery.
          </p>

          <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
            <button
              type="button"
              data-uopen-file
              class="inline-flex h-11 items-center gap-2 rounded-full bg-ink px-5 text-[14px] font-heading text-on-ink transition-colors hover:bg-ink-soft"
            >
              <Icon name="eraser" size={16} />
              Choose a redacted image
            </button>
            <span class="inline-flex items-center gap-1.5 px-2 text-[11px] text-muted">
              <Icon name="lock" size={12} />
              Nothing is uploaded
            </span>
          </div>

          <input
            class="hidden"
            data-ufile-input
            type="file"
            tabindex="-1"
            accept="image/png,image/jpeg,image/webp,image/gif,image/bmp,image/avif"
            aria-label="Choose a redacted image to repair"
          />

          <div class="mx-auto mt-5 flex max-w-xl items-start gap-2 rounded-tile bg-canvas p-3 text-left text-[11px] leading-relaxed text-muted">
            <Icon name="alert" size={14} class="mt-0.5 shrink-0 text-ink" />
            <p>
              <span class="font-heading text-ink">A repair is not a reveal.</span>{' '}
              Opaque black bars have no hidden layer. The fill is an approximation built from nearby
              pixels, and the original detail is gone for good. Use this only on images you own or have
              permission to edit.
            </p>
          </div>

          <p class="mt-4 text-[11px] text-faint">
            Your browser reads the file locally. There is no upload endpoint.
          </p>
        </div>

        <div class="mx-auto mt-9 max-w-3xl border-t border-hairline-soft pt-5">
          <p class="text-center text-[11px] font-heading text-muted">Or try a redacted sample</p>
          <div class="mt-3 grid grid-cols-2 gap-2.5 sm:grid-cols-4">
            {
              samples.map((sample) => (
                <button
                  type="button"
                  data-unredact-sample={sample.src}
                  data-unredact-sample-name={sample.name}
                  class="group rounded-tile text-left disabled:opacity-50"
                  aria-label={`Try the redacted ${sample.name} sample`}
                >
                  <span class="block overflow-hidden rounded-tile border border-hairline bg-canvas">
                    <img
                      src={sample.src}
                      width="480"
                      height="320"
                      alt=""
                      decoding="async"
                      class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-[1.025]"
                    />
                  </span>
                  <span class="mt-2 flex items-baseline justify-between gap-2 text-[11px] leading-tight">
                    <span class="font-heading">{sample.label}</span>
                    <span class="text-faint">Redacted</span>
                  </span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div data-uworkspace hidden>
      <div class="flex flex-wrap items-center gap-1.5 border-b border-hairline-soft px-2 py-2 md:px-3">
        <button
          type="button"
          data-uaction="detect"
          class="inline-flex h-8 items-center gap-1.5 rounded-full bg-ink px-3 text-[12px] font-heading text-on-ink transition-colors hover:bg-ink-soft disabled:opacity-40"
          title="Find solid redaction bars on this device"
        >
          <Icon name="sparkles" size={14} />
          Find bars
        </button>

        <div class="relative">
          <label class="sr-only" for="unredact-sensitivity">Detection sensitivity</label>
          <select
            id="unredact-sensitivity"
            data-usensitivity
            class="h-8 appearance-none rounded-full bg-canvas-soft pl-3 pr-8 text-[11px] font-heading text-ink"
          >
            <option value="strict">Strict</option>
            <option value="balanced" selected>Balanced</option>
            <option value="broad">Broad</option>
          </select>
          <Icon name="chevron-down" size={11} class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-muted" />
        </div>

        <div class="ml-auto flex items-center gap-0.5">
          <button type="button" class="icon-btn" data-uopen-file aria-label="Replace image" title="Replace image">
            <Icon name="refresh" size={15} />
          </button>
          <button
            type="button"
            class="icon-btn"
            data-uaction="reset"
            aria-label="Reset to the original image"
            title="Reset to the original"
            disabled
          >
            <Icon name="undo" size={15} />
          </button>
          <button
            type="button"
            class="tool-btn !px-2"
            data-uaction="compare"
            aria-pressed="false"
            aria-label="Compare the repair with the original"
            title="Compare with the original (C)"
            disabled
          >
            <Icon name="eye" size={14} />
            <span class="hidden lg:inline">Compare</span>
          </button>
        </div>
      </div>

      <div
        data-ubanner
        hidden
        aria-live="polite"
        class="border-b border-hairline-soft bg-canvas-soft px-3 py-2.5 md:px-4"
      >
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-canvas">
            <Icon name="eraser" size={15} />
          </span>
          <div class="min-w-[170px] flex-1">
            <p data-ubanner-title class="text-[12px] font-heading leading-tight"></p>
            <p data-ubanner-sub class="text-[11px] leading-snug text-muted"></p>
          </div>
          <button
            type="button"
            data-uaction="repair"
            class="inline-flex h-8 items-center rounded-full bg-ink px-3 text-[12px] font-heading text-on-ink disabled:opacity-40"
            disabled
          >
            Remove 0 bars
          </button>
        </div>
      </div>

      <div class="canvas-stage relative flex min-h-[300px] items-center justify-center overflow-auto p-4 md:min-h-[420px] md:p-6">
        <div class="canvas-frame" data-ucanvas-frame>
          <canvas
            data-ucanvas
            tabindex="0"
            aria-label="Redacted image canvas. Marks show areas the unredactor can rebuild. Drag over an area to add it."
            aria-describedby="unredact-canvas-help"
          ></canvas>
          <div data-uoverlay class="pointer-events-none absolute inset-0">
            <div data-usuggestions class="pointer-events-none absolute inset-0 z-10"></div>
            <div data-ughost hidden class="ghost-box z-30"></div>
          </div>
        </div>

        <p id="unredact-canvas-help" class="sr-only">
          Detected redaction bars are marked in blue. Click a mark to include or exclude it. Drag over
          an unmarked area to add a manual repair box. Press C to compare with the original and Escape
          to cancel a selection.
        </p>

        <div
          data-uoriginal-badge
          hidden
          class="pointer-events-none absolute left-4 top-4 z-30 inline-flex items-center gap-1.5 rounded-full bg-ink px-2.5 py-1 text-[11px] font-heading text-on-ink md:left-6 md:top-6"
        >
          <Icon name="eye" size={12} />
          Original
        </div>

        <div
          data-urepaired-badge
          hidden
          class="pointer-events-none absolute left-4 top-4 z-30 inline-flex items-center gap-1.5 rounded-full bg-ink px-2.5 py-1 text-[11px] font-heading text-on-ink md:left-6 md:top-6"
        >
          <Icon name="shield-check" size={12} />
          Repaired
        </div>

        <div
          data-ubusy
          hidden
          role="status"
          aria-live="polite"
          class="absolute inset-0 z-40 grid place-items-center bg-canvas/85 px-6 backdrop-blur-sm"
        >
          <div class="w-full max-w-xs text-center">
            <div class="mx-auto grid h-11 w-11 place-items-center rounded-full bg-canvas">
              <Icon name="eraser" size={20} class="animate-pulse" />
            </div>
            <p data-ubusy-label class="mt-4 text-[13px] font-heading leading-tight">Looking for solid bars…</p>
            <p class="mt-3 text-[11px] leading-relaxed text-muted">
              Everything happens in this tab. The image is never sent anywhere.
            </p>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-start gap-2 border-t border-hairline-soft bg-canvas-soft px-3 py-2.5 text-[11px] leading-relaxed text-muted md:px-4">
        <Icon name="info" size={13} class="mt-0.5 shrink-0 text-ink" />
        <p>
          The rebuilt area is a best-effort fill, not the original pixels. If the bar was translucent
          rather than opaque, some detail may survive — but never rely on a repair to prove what a
          redaction hid.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-hairline-soft px-3 py-2.5 md:px-4">
        <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
          <span class="inline-flex items-center gap-1.5 text-[11px] text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
            <span data-ucount>0</span>
            <span data-ucount-label>areas selected</span>
          </span>
          <span data-ustatus class="text-[11px] text-muted" aria-live="polite"></span>
        </div>

        <div class="ml-auto flex flex-wrap items-center gap-1.5">
          <div class="relative">
            <label class="sr-only" for="unredact-format">Download format</label>
            <select
              id="unredact-format"
              data-uformat
              class="h-9 appearance-none rounded-full bg-canvas-soft pl-3 pr-8 text-[11px] font-heading text-ink"
            >
              <option value="image/png">PNG</option>
              <option value="image/jpeg">JPG</option>
              <option value="image/webp">WebP</option>
            </select>
            <Icon name="chevron-down" size={12} class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-muted" />
          </div>
          <button
            type="button"
            data-uaction="download"
            class="inline-flex h-9 items-center gap-1.5 rounded-full bg-ink px-3.5 text-[11px] font-heading text-on-ink transition-colors hover:bg-ink-soft disabled:opacity-40"
            disabled
          >
            <Icon name="download" size={13} />
            Download repair
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" data-utoast role="status" aria-live="polite"></div>

  <div class="mt-3 grid gap-2 px-1 text-[11px] text-muted sm:grid-cols-3">
    <p class="inline-flex items-center gap-1.5">
      <Icon name="lock" size={12} />
      Detected and rebuilt in this tab.
    </p>
    <p class="inline-flex items-center gap-1.5 sm:justify-center">
      <Icon name="scan" size={12} />
      Solid bars only. Mark missed areas by hand.
    </p>
    <p class="inline-flex items-center gap-1.5 sm:justify-end">
      <Icon name="alert" size={12} />
      Reconstruction, not recovery.
    </p>
  </div>
</section>

<script>
  import '../scripts/unredactor';
</script>
