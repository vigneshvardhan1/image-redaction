---
import Icon from './Icon.astro';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en-US' } = Astro.props;
---

{/*
  The theme is owned by the inline script in BaseLayout: it applies the stored
  theme before the first paint and handles the toggle from the very first
  click, so the button works while the intro is still on screen.
*/}
<button
  type="button"
  data-theme-toggle
  data-label-dark={t(locale, 'theme.switchToDark')}
  data-label-light={t(locale, 'theme.switchToLight')}
  class="theme-toggle"
  title={t(locale, 'theme.title')}
>
  <Icon name="moon" size={18} class="theme-icon-moon" />
  <Icon name="sun" size={18} class="theme-icon-sun" />
  <span class="sr-only theme-label-light">{t(locale, 'theme.switchToDark')}</span>
  <span class="sr-only theme-label-dark">{t(locale, 'theme.switchToLight')}</span>
</button>
