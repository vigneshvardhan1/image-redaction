---
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const links = [
  { label: 'Editor', href: '/#editor', match: '/' },
  { label: 'Features', href: '/features', match: '/features' },
  { label: 'Privacy', href: '/privacy', match: '/privacy' },
  { label: 'Guides', href: '/guides', match: '/guides' },
  { label: 'FAQ', href: '/#faq', match: '/#faq' },
];

function isActive(link: (typeof links)[number]) {
  if (link.match === '/') return path === '/';
  return path.startsWith(link.match);
}
---

<header class="sticky top-0 z-50 pt-3 md:pt-5">
  <div class="container-page">
    <div class="relative mx-auto max-w-[1080px]">
      <nav
        class="flex items-center justify-between gap-3 rounded-full bg-canvas-soft/92 py-2 pl-3 pr-2 backdrop-blur-xl md:pl-4"
        aria-label="Primary"
      >
        <Logo size="sm" />

        <div class="hidden items-center gap-1 lg:flex">
          {
            links.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'rounded-full px-3 py-2 text-[15px] leading-none transition-colors',
                  isActive(link) ? 'font-heading text-ink' : 'text-muted hover:text-ink',
                ]}
                aria-current={isActive(link) ? 'page' : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </div>

        <div class="flex items-center gap-1.5">
          <ThemeToggle />
          <span class="hidden sm:block">
            <Button href="/#editor" size="md" iconRight="arrow-right">
              Redact an image
            </Button>
          </span>
          <Button
            variant="ghost"
            size="sm"
            class="!h-11 !w-11 !px-0 lg:hidden"
            ariaLabel="Open menu"
            dataAttrs={{ 'data-menu-toggle': 'true', 'aria-expanded': 'false', 'aria-controls': 'mobile-menu' }}
          >
            <Icon name="menu" size={18} />
          </Button>
        </div>
      </nav>

      <div
        id="mobile-menu"
        data-menu
        hidden
        class="absolute inset-x-0 top-[calc(100%+8px)] rounded-card border border-hairline-soft bg-canvas p-2 shadow-none lg:hidden"
      >
        <div class="grid gap-0.5">
          {
            links.map((link) => (
              <a
                href={link.href}
                class="flex min-h-11 items-center justify-between rounded-tile px-3 text-[16px] hover:bg-canvas-soft"
                data-menu-link
              >
                {link.label}
                <Icon name="arrow-up-right" size={15} class="text-faint" />
              </a>
            ))
          }
        </div>
        <div class="mt-2 border-t border-hairline-soft p-1 pt-3">
          <Button href="/#editor" size="md" iconRight="arrow-right" class="w-full" dataAttrs={{ 'data-menu-link': 'true' }}>
            Redact an image
          </Button>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  function closeMenu() {
    if (!toggle || !menu) return;
    menu.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open menu');
  }

  toggle?.addEventListener('click', () => {
    if (!menu) return;
    const open = menu.hidden;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });

  menu?.querySelectorAll('[data-menu-link]').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
