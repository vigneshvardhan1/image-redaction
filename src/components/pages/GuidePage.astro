---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import GuideCard from '../GuideCard.astro';
import CtaBand from '../CtaBand.astro';
import type { Guide, GuideBlock } from '../../data/guides';
import type { Locale } from '../../i18n/config';
import { DEFAULT_LOCALE, LOCALES, localeConfig, localizePath } from '../../i18n/config';
import { getGuides } from '../../i18n/content/guides';
import { t } from '../../i18n/ui';

interface Props {
  guide: Guide;
  locale?: Locale;
  availableLocales?: Locale[];
}

const { guide, locale = DEFAULT_LOCALE, availableLocales = LOCALES } = Astro.props;
const site = Astro.site ?? new URL('https://imageredaction.com');
const canonical = new URL(Astro.url.pathname, site).href;
const homeHref = localizePath(locale, '/');
const guidesHref = localizePath(locale, '/guides');
const related = getGuides(locale)
  .filter((item) => item.slug !== guide.slug)
  .slice(0, 2);

const publishedDate = new Intl.DateTimeFormat(localeConfig[locale].intl, {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${guide.dateISO}T00:00:00Z`));

function slugify(value: string): string {
  return value
    .toLowerCase()
    .replace(/ß/g, 'ss')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

const headings = guide.blocks
  .filter((block): block is Extract<GuideBlock, { type: 'h2' }> => block.type === 'h2')
  .map((block) => ({ text: block.text, id: slugify(block.text) }));

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.description,
  datePublished: guide.dateISO,
  dateModified: guide.dateISO,
  articleSection: guide.category,
  inLanguage: locale,
  image: new URL(guide.cover, site).href,
  mainEntityOfPage: canonical,
  author: {
    '@type': 'Organization',
    name: 'Redact',
    url: homeHref,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Redact',
    url: homeHref,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Redact', item: new URL(homeHref, site).href },
    {
      '@type': 'ListItem',
      position: 2,
      name: t(locale, 'guide.backToGuides'),
      item: new URL(guidesHref, site).href,
    },
    { '@type': 'ListItem', position: 3, name: guide.title, item: canonical },
  ],
};

const sample = guide.slug.includes('receipt')
  ? { path: '/samples/receipt.svg', name: 'Receipt' }
  : guide.slug.includes('work')
    ? { path: '/samples/dashboard.svg', name: 'Dashboard' }
    : guide.slug.includes('id')
      ? { path: '/samples/id.svg', name: 'Student ID' }
      : { path: '/samples/chat.svg', name: 'Chat screenshot' };
---

<BaseLayout
  title={`${guide.title} — Redact`}
  description={guide.description}
  schema={[articleSchema, breadcrumbSchema]}
  ogType="article"
  ogImageAlt={guide.title}
  locale={locale}
  availableLocales={availableLocales}
  splash
>
  <article>
    <header class="container-page pt-10 md:pt-14">
      <nav
        aria-label={t(locale, 'guide.breadcrumbAria')}
        class="flex flex-wrap items-center gap-2 text-[11px] text-muted"
      >
        <a href={guidesHref} class="hover:text-ink">{t(locale, 'guide.backToGuides')}</a>
        <span class="text-faint" aria-hidden="true">/</span>
        <span>{guide.category}</span>
      </nav>

      <div class="mt-8 max-w-4xl">
        <p class="flex flex-wrap items-center gap-2 text-[12px] font-heading leading-none text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
          {guide.category}
          <span class="text-faint" aria-hidden="true">·</span>
          <span class="font-body">{guide.readingTime}</span>
        </p>
        <h1 class="mt-4 text-h1">{guide.title}</h1>
        <p class="mt-5 max-w-2xl text-[19px] font-light leading-relaxed text-muted">
          {guide.description}
        </p>
        <p class="mt-6 flex items-center gap-2 text-[11px] text-faint">
          <Icon name="clock" size={12} />
          <span>
            {t(locale, 'guide.published')}
            <time datetime={guide.dateISO}>{publishedDate}</time>
          </span>
        </p>
      </div>
    </header>

    <div class="container-page mt-9 md:mt-12">
      <div class="overflow-hidden rounded-panel border border-hairline-soft bg-canvas-soft">
        <img
          src={guide.cover}
          width="1200"
          height="750"
          alt={guide.coverAlt}
          class="aspect-[16/9] w-full object-cover object-center md:aspect-[2.4/1]"
          decoding="async"
        />
      </div>
    </div>

    <div class="container-page mt-12 md:mt-16">
      <div class="grid gap-10 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-16">
        <aside class="hidden self-start lg:sticky lg:top-28 lg:block">
          <p class="text-[11px] font-heading text-muted">{t(locale, 'guide.onThisPage')}</p>
          <nav aria-label={t(locale, 'guide.onThisPage')} class="mt-4">
            <ol class="space-y-2.5">
              {
                headings.map((heading, index) => (
                  <li class="flex gap-2.5">
                    <span class="mt-0.5 text-[10px] font-heading text-faint">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <a
                      href={`#${heading.id}`}
                      class="text-[12px] leading-snug text-muted transition-colors hover:text-ink"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>

          <div class="mt-7 rounded-card bg-canvas-soft p-4">
            <p class="text-[13px] font-heading leading-tight">{t(locale, 'guide.readyToTry')}</p>
            <p class="mt-1.5 text-[11px] leading-relaxed text-muted">
              {t(locale, 'guide.readyCopy')}
            </p>
            <Button
              href={localizePath(locale, '/#editor')}
              size="sm"
              class="mt-3 w-full"
              iconRight="arrow-right"
            >
              {t(locale, 'nav.cta')}
            </Button>
          </div>
        </aside>

        <div class="min-w-0 max-w-2xl">
          <p class="text-[18px] font-light leading-[1.6] text-ink">{guide.intro}</p>

          <div class="mt-8">
            {
              guide.blocks.map((block) =>
                block.type === 'h2' ? (
                  <h2
                    id={slugify(block.text)}
                    class="mt-12 scroll-mt-28 text-[27px] leading-[1.15] first:mt-0"
                  >
                    {block.text}
                  </h2>
                ) : block.type === 'h3' ? (
                  <h3 class="mt-8 text-[20px] leading-tight">{block.text}</h3>
                ) : block.type === 'p' ? (
                  <p class="mt-4 text-[15.5px] leading-[1.75] text-ink-soft">{block.text}</p>
                ) : block.type === 'ul' ? (
                  <ul class="mt-5 space-y-2.5">
                    {block.items.map((item) => (
                      <li class="flex gap-2.5 text-[15px] leading-[1.65] text-ink-soft">
                        <span
                          class="mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-ink"
                          aria-hidden="true"
                        />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                ) : block.type === 'steps' ? (
                  <ol class="mt-6 space-y-2.5">
                    {block.items.map((item, index) => (
                      <li class="flex gap-3 rounded-tile border border-hairline-soft bg-canvas p-4">
                        <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-canvas-soft text-[10px] font-heading">
                          {index + 1}
                        </span>
                        <div>
                          <p class="text-[13px] font-heading leading-tight">{item.title}</p>
                          <p class="mt-1 text-[12px] leading-relaxed text-muted">{item.text}</p>
                        </div>
                      </li>
                    ))}
                  </ol>
                ) : block.type === 'callout' ? (
                  <aside
                    class:list={[
                      'mt-8 rounded-card p-5',
                      block.tone === 'warning'
                        ? 'border border-hairline bg-canvas-soft'
                        : 'border border-hairline-soft bg-canvas',
                    ]}
                  >
                    <div class="flex gap-3">
                      <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full bg-canvas">
                        <Icon name={block.tone === 'warning' ? 'alert' : 'info'} size={15} />
                      </span>
                      <div>
                        <p class="text-[10px] font-heading text-muted">
                          {block.tone === 'warning'
                            ? t(locale, 'guide.caution')
                            : t(locale, 'guide.note')}
                        </p>
                        <p class="mt-1 text-[13px] font-heading leading-tight">{block.title}</p>
                        <p class="mt-1.5 text-[12px] leading-relaxed text-muted">{block.text}</p>
                      </div>
                    </div>
                  </aside>
                ) : block.type === 'quote' ? (
                  <blockquote class="mt-10 border-l-2 border-ink pl-5 text-[18px] font-light leading-relaxed text-ink">
                    {block.text}
                  </blockquote>
                ) : null
              )
            }
          </div>

          <div class="mt-12 rounded-card bg-canvas-soft p-6">
            <p class="flex items-center gap-2 text-[11px] font-heading text-muted">
              <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
              {t(locale, 'guide.shortVersion')}
            </p>
            <ul class="mt-4 space-y-2.5">
              {
                guide.takeaways.map((takeaway) => (
                  <li class="flex gap-2.5 text-[13px] leading-relaxed text-ink">
                    <Icon name="check" size={13} class="mt-0.5 shrink-0" />
                    {takeaway}
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-hairline-soft pt-6">
            <p class="text-[12px] text-muted">{t(locale, 'guide.practice')}</p>
            <Button
              dataAttrs={{
                'data-redactor-sample': sample.path,
                'data-redactor-sample-name': sample.name,
              }}
              size="sm"
              iconRight="arrow-right"
            >
              {t(locale, 'guide.trySample')}
            </Button>
          </div>
        </div>
      </div>
    </div>
  </article>

  <section class="container-page mt-20 md:mt-28">
    <div class="flex flex-col justify-between gap-4 border-b border-hairline-soft pb-5 sm:flex-row sm:items-end">
      <h2 class="text-h3">{t(locale, 'guide.keepReading')}</h2>
      <Button href={guidesHref} variant="soft" iconRight="arrow-up-right">
        {t(locale, 'guide.allGuides')}
      </Button>
    </div>
    <div class="mt-6 grid gap-3 md:grid-cols-2">
      {
        related.map((item) => (
          <GuideCard guide={item} locale={locale} readLabel={t(locale, 'demo.readGuide')} />
        ))
      }
    </div>
  </section>

  <CtaBand
    class="mt-20 md:mt-28"
    eyebrow={t(locale, 'ctaBand.eyebrow')}
    title={t(locale, 'guide.readyToTry')}
    copy={t(locale, 'guide.readyCopy')}
    cta={t(locale, 'nav.cta')}
    href={localizePath(locale, '/#editor')}
    secondary={t(locale, 'guide.allGuides')}
    secondaryHref={guidesHref}
    locale={locale}
  />
</BaseLayout>
