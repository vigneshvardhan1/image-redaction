---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import Redactor from '../Redactor.astro';
import SectionHead from '../SectionHead.astro';
import DetectionShowcase from '../DetectionShowcase.astro';
import ModeDemos from '../ModeDemos.astro';
import RedactionTour from '../RedactionTour.astro';
import ComparisonTable from '../ComparisonTable.astro';
import GuideCard from '../GuideCard.astro';
import Faq from '../Faq.astro';
import CtaBand from '../CtaBand.astro';
import ImageRedactionGuide from '../ImageRedactionGuide.astro';
import type { Locale } from '../../i18n/config';
import { LOCALES, localeConfig, localizePath } from '../../i18n/config';
import { getHomeContent } from '../../i18n/content/home';
import { getHomeFaqs } from '../../i18n/content/faq';
import { getGuides } from '../../i18n/content/guides';
import { getFeaturesContent } from '../../i18n/content/features';
import { buildFaqSchema } from '../../data/faq';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
  availableLocales?: Locale[];
}

const { locale, availableLocales = LOCALES } = Astro.props;
const content = getHomeContent(locale);
const { meta, hero, useCasesHead, facts, proof, useCases, detection, styles, privacy, compare, how, guide, guides, faq, cta } =
  content;
const detectionPoints = detection.points;
const privacyPoints = privacy.points;
const steps = how.steps;
const homeFaqs = getHomeFaqs(locale);
const latestGuides = getGuides(locale).slice(0, 3);

const site = Astro.site ?? new URL('https://imageredaction.com');
const canonical = new URL(Astro.url.pathname, site).href;
const localizedHome = new URL(localizePath(locale, '/'), site).href;

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Redact',
  alternateName: 'Image Redaction Tool',
  url: localizedHome,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any modern web browser',
  browserRequirements: 'Requires JavaScript. Smart detection downloads an OCR model on first use.',
  inLanguage: locale,
  isAccessibleForFree: true,
  description: meta.description,
  keywords: meta.keywords.join(', '),
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: localeConfig[locale].currency,
  },
  featureList: getFeaturesContent(locale).features.map((feature) => feature.title),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Redact',
  alternateName: 'Image Redaction',
  url: localizedHome,
  inLanguage: locale,
  description: meta.description,
};

const faqSchema = buildFaqSchema(homeFaqs);
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  schema={[appSchema, websiteSchema, faqSchema]}
  ogImageAlt={meta.ogImageAlt}
  locale={locale}
  availableLocales={availableLocales}
  splash
>
  <section class="container-page pb-8 pt-14 md:pt-20">
    <div class="mx-auto max-w-4xl text-center">
      <a
        href="#image-redaction"
        class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas px-3 py-1.5 text-[12px] leading-none transition-colors hover:bg-canvas-soft"
      >
        <Icon name="sparkles" size={13} class="text-muted" />
        <span class="font-heading">{hero.badge}</span>
        <Icon name="arrow-right" size={12} class="text-muted" />
      </a>

      <h1 class="mx-auto mt-6 max-w-4xl text-[2.55rem] leading-[1.02] text-balance sm:text-display sm:leading-[0.98]">
        {hero.title[0]}<span class="block">{hero.title[1]}</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-[19px] font-light leading-relaxed text-muted md:text-[21px]">
        {hero.lead}
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-2 sm:flex-row">
        <Button href="#editor" size="lg" iconRight="arrow-right">{hero.primaryCta}</Button>
        <Button href="#how-it-works" variant="outline" size="lg">{hero.secondaryCta}</Button>
      </div>

      <p class="mt-5 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-[12px] text-muted">
        {
          hero.proof.map((item, index) => (
            <>
              {index > 0 && (
                <span class="text-faint" aria-hidden="true">
                  ·
                </span>
              )}
              <span>{item}</span>
            </>
          ))
        }
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-[1080px] md:mt-14">
      <Redactor />
    </div>
  </section>

  <section class="container-page mt-12 md:mt-16" aria-label="Privacy and product facts">
    <div class="grid grid-cols-2 gap-px overflow-hidden rounded-card border border-hairline-soft bg-hairline-soft md:grid-cols-4">
      {
        facts.map((fact) => (
          <div class="bg-canvas p-5">
            <span class="grid h-8 w-8 place-items-center rounded-full bg-canvas-soft">
              <Icon name={fact.icon as any} size={15} />
            </span>
            <p class="mt-3 text-[13px] font-heading leading-tight">{fact.title}</p>
            <p class="mt-1 text-[11px] leading-relaxed text-muted">{fact.copy}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="proof" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <div class="grid gap-9 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-12">
      <div>
        <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
          {proof.eyebrow}
        </p>
        <h2 class="mt-4 text-h2">{proof.title}</h2>
        <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-muted">
          {proof.copy}
        </p>

        <div class="mt-7 space-y-4">
          {
            proof.points.map((point) => (
              <div class="flex gap-3">
                <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full bg-canvas-soft">
                  <Icon name={point.icon as any} size={14} />
                </span>
                <div>
                  <p class="text-[14px] font-heading leading-tight">{point.title}</p>
                  <p class="mt-1 text-[12px] leading-relaxed text-muted">{point.copy}</p>
                </div>
              </div>
            ))
          }
        </div>

        <div class="mt-7">
          <Button
            variant="outline"
            iconRight="arrow-right"
            dataAttrs={{
              'data-redactor-sample': '/samples/id.svg',
              'data-redactor-sample-name': proof.sampleName,
            }}
          >
            {proof.cta}
          </Button>
        </div>
      </div>

      <RedactionTour locale={locale} />
    </div>
  </section>

  <section id="use-cases" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <SectionHead
      eyebrow={useCasesHead.eyebrow}
      title={useCasesHead.title}
      copy={useCasesHead.copy}
    />

    <div class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        useCases.map((useCase) => (
          <article class="group flex flex-col overflow-hidden rounded-card border border-hairline-soft bg-canvas">
            <div class="relative aspect-[3/2] overflow-hidden border-b border-hairline-soft bg-canvas-soft">
              <img
                src={useCase.sample.replace(/\.svg$/, '-redacted.svg')}
                width="1200"
                height="800"
                alt={useCase.alt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.02]"
              />
              <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-heading leading-none text-overlay-ink backdrop-blur-sm">
                <Icon name="lock" size={10} />
                {t(locale, 'demo.redacted')}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-5">
              <div class="flex items-center gap-2.5">
                <span class="grid h-8 w-8 place-items-center rounded-full bg-canvas-soft">
                  <Icon name={useCase.icon as any} size={15} />
                </span>
                <h3 class="text-[19px] leading-tight">{useCase.title}</h3>
              </div>
              <p class="mt-3 text-[13px] leading-relaxed text-muted">{useCase.copy}</p>
              <button
                type="button"
                data-redactor-sample={useCase.sample}
                data-redactor-sample-name={useCase.sampleName}
                class="mt-5 inline-flex min-h-8 items-center gap-1.5 self-start text-[12px] font-heading text-ink hover:underline"
              >
                {t(locale, 'demo.openSample')}
                <Icon name="arrow-up-right" size={12} />
              </button>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section id="detection" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <div class="rounded-panel bg-canvas-soft p-5 md:p-10 lg:p-12">
      <div class="grid gap-9 lg:grid-cols-[1fr_0.95fr] lg:items-center lg:gap-12">
        <div>
          <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
            {detection.eyebrow}
          </p>
          <h2 class="mt-4 text-h2">{detection.title}</h2>
          <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-muted">
            {detection.copy}
          </p>
          <ul class="mt-6 space-y-2.5">
            {
              detectionPoints.map((point) => (
                <li class="flex items-start gap-2.5 text-[13px] leading-relaxed text-ink">
                  <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-canvas">
                    <Icon name="check" size={11} />
                  </span>
                  {point}
                </li>
              ))
            }
          </ul>
          <div class="mt-7 flex flex-col gap-2 sm:flex-row">
            <Button href="#editor" iconRight="arrow-right">
              {detection.primaryCta}
            </Button>
            <Button href={localizePath(locale, '/guides/how-to-redact-a-screenshot')} variant="outline">
              {detection.secondaryCta}
            </Button>
          </div>
        </div>

        <DetectionShowcase locale={locale} />
      </div>
    </div>
    <p class="mt-3 px-1 text-[11px] leading-relaxed text-faint">
      {detection.footnote}
    </p>
  </section>

  <section id="styles" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <SectionHead eyebrow={styles.eyebrow} title={styles.title} copy={styles.copy}>
      <Button slot="actions" href="#editor" variant="soft" iconRight="arrow-up-right">
        {styles.cta}
      </Button>
    </SectionHead>
    <div class="mt-8">
      <ModeDemos locale={locale} />
    </div>
  </section>

  <section id="privacy" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <div class="rounded-panel bg-canvas-soft p-5 md:p-10 lg:p-12">
      <div class="grid gap-9 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
        <div>
          <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
            {privacy.eyebrow}
          </p>
          <h2 class="mt-4 text-h2">{privacy.title}</h2>
          <p class="mt-4 text-[16px] leading-relaxed text-muted">
            {privacy.copy}
          </p>
          <div class="mt-6">
            <Button href={localizePath(locale, '/privacy')} variant="soft" iconRight="arrow-up-right">
              {privacy.cta}
            </Button>
          </div>
        </div>

        <div class="divide-y divide-hairline">
          {
            privacyPoints.map((point) => (
              <div class="flex gap-4 py-5 first:pt-0 last:pb-0">
                <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full bg-canvas">
                  <Icon name={point.icon as any} size={16} />
                </span>
                <div>
                  <p class="text-[14px] font-heading leading-tight">{point.title}</p>
                  <p class="mt-1.5 text-[12px] leading-relaxed text-muted">{point.copy}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="compare" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <SectionHead eyebrow={compare.eyebrow} title={compare.title} copy={compare.copy} />
    <div class="mt-8">
      <ComparisonTable locale={locale} />
    </div>
  </section>

  <section id="how-it-works" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <SectionHead
      align="center"
      eyebrow={how.eyebrow}
      title={how.title}
      copy={how.copy}
    />
    <div class="mt-10 grid gap-3 md:grid-cols-3">
      {
        steps.map((step) => (
          <div class="rounded-card bg-canvas-soft p-6">
            <div class="flex items-center justify-between">
              <span class="text-[38px] font-light leading-none text-faint">{step.number}</span>
              <span class="grid h-9 w-9 place-items-center rounded-full bg-canvas">
                <Icon name={step.icon as any} size={16} />
              </span>
            </div>
            <h3 class="mt-8 text-[19px] leading-tight">{step.title}</h3>
            <p class="mt-2 text-[13px] leading-relaxed text-muted">{step.copy}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-8 text-center">
      <Button href="#editor" iconRight="arrow-right">{how.cta}</Button>
    </div>
  </section>

  <ImageRedactionGuide locale={locale} guide={guide} />

  <section id="guides" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <SectionHead eyebrow={guides.eyebrow} title={guides.title} copy={guides.copy}>
      <Button slot="actions" href={localizePath(locale, '/guides')} variant="soft" iconRight="arrow-up-right">
        {guides.cta}
      </Button>
    </SectionHead>
    <div class="mt-8 grid gap-3 md:grid-cols-3">
      {
        latestGuides.map((item) => (
          <GuideCard guide={item} locale={locale} readLabel={t(locale, 'demo.readGuide')} />
        ))
      }
    </div>
  </section>

  <section id="faq" class="container-page mt-20 scroll-mt-28 md:mt-28" aria-labelledby="faq-heading">
    <div class="grid gap-9 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
      <div class="self-start lg:sticky lg:top-28">
        <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
          {faq.eyebrow}
        </p>
        <h2 id="faq-heading" class="mt-4 text-h2">{faq.title}</h2>
        <p class="mt-4 max-w-md text-[15px] leading-relaxed text-muted">
          {faq.copy}
        </p>
        <a
          href="mailto:hello@imageredaction.com?subject=Redact%20question"
          class="mt-5 inline-flex items-center gap-1.5 text-[13px] font-heading text-ink hover:underline"
        >
          {faq.ask}
          <Icon name="arrow-up-right" size={13} />
        </a>
      </div>
      <Faq items={homeFaqs} />
    </div>
  </section>

  <CtaBand
    class="mt-20 md:mt-28"
    eyebrow={cta.eyebrow}
    title={cta.title}
    copy={cta.copy}
    cta={cta.primary}
    href={localizePath(locale, '/#editor')}
    secondary={cta.secondary}
    secondaryHref={localizePath(locale, cta.secondaryHref ?? '/privacy')}
    locale={locale}
  />
</BaseLayout>
