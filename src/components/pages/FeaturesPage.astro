---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import DetectionShowcase from '../DetectionShowcase.astro';
import ModeDemos from '../ModeDemos.astro';
import BeforeAfter from '../BeforeAfter.astro';
import CtaBand from '../CtaBand.astro';
import type { Locale } from '../../i18n/config';
import { LOCALES, localizePath } from '../../i18n/config';
import { getFeaturesContent } from '../../i18n/content/features';

interface Props {
  locale: Locale;
  availableLocales?: Locale[];
}

const { locale, availableLocales = LOCALES } = Astro.props;
const content = getFeaturesContent(locale);
const { meta, hero, features, detection, styles, review, delivery, proof, shortcuts, limits, cta } =
  content;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  ogImageAlt={meta.title}
  locale={locale}
  availableLocales={availableLocales}
  splash
>
  <PageHero eyebrow={hero.eyebrow} title={hero.title} lead={hero.lead}>
    <Button slot="actions" href={localizePath(locale, '/#editor')} size="lg" iconRight="arrow-right">
      {hero.primaryCta}
    </Button>
    <Button slot="actions" href={localizePath(locale, '/privacy')} variant="outline" size="lg">
      {hero.secondaryCta}
    </Button>
  </PageHero>

  <section class="container-page">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <article class="rounded-card border border-hairline-soft bg-canvas p-5">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-canvas-soft">
              <Icon name={feature.icon as any} size={16} />
            </span>
            <h2 class="mt-4 text-[17px] leading-tight">{feature.title}</h2>
            <p class="mt-2 text-[13px] leading-relaxed text-muted">{feature.copy}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container-page mt-20 md:mt-28">
    <div class="grid gap-9 lg:grid-cols-[1fr_0.95fr] lg:items-center lg:gap-12">
      <div>
        <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
          {detection.eyebrow}
        </p>
        <h2 class="mt-4 text-h2">{detection.title}</h2>
        <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-muted">
          {detection.copy}
        </p>

        <div class="mt-7 grid gap-3 sm:grid-cols-2">
          {
            detection.cards.map((card) => (
              <div class="rounded-tile bg-canvas-soft p-4">
                <p class="text-[13px] font-heading leading-tight">{card.title}</p>
                <p class="mt-2 text-[12px] leading-relaxed text-muted">{card.copy}</p>
              </div>
            ))
          }
        </div>

        <div class="mt-7">
          <Button href={localizePath(locale, '/#editor')} iconRight="arrow-right">
            {detection.cta}
          </Button>
        </div>
      </div>

      <DetectionShowcase locale={locale} />
    </div>
  </section>

  <section class="container-page mt-20 md:mt-28">
    <SectionHead eyebrow={styles.eyebrow} title={styles.title} copy={styles.copy} />
    <div class="mt-8">
      <ModeDemos locale={locale} />
    </div>
  </section>

  <section class="container-page mt-20 md:mt-28">
    <div class="grid gap-9 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-12">
      <div>
        <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
          {review.eyebrow}
        </p>
        <h2 class="mt-4 text-h2">{review.title}</h2>
        <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-muted">
          {review.copy}
        </p>

        <div class="mt-7 space-y-4">
          {
            review.points.map((point) => (
              <div class="flex gap-3">
                <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full bg-canvas-soft">
                  <Icon name={point.icon as any} size={14} />
                </span>
                <div>
                  <p class="text-[14px] font-heading leading-tight">{point.title}</p>
                  <p class="mt-1 text-[12px] leading-relaxed text-muted">{point.copy}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="overflow-hidden rounded-card border border-hairline-soft bg-canvas">
        <div class="flex items-center justify-between gap-3 border-b border-hairline-soft px-4 py-3">
          <div class="flex items-center gap-2">
            <span class="grid h-7 w-7 place-items-center rounded-full bg-canvas-soft">
              <Icon name="shield-check" size={14} />
            </span>
            <span class="text-[11px] font-heading">{review.panel.title}</span>
          </div>
          <span class="rounded-full bg-canvas-soft px-2.5 py-1 text-[10px] text-muted">
            {review.panel.badge}
          </span>
        </div>
        <div class="p-4">
          <div class="flex items-start gap-3 rounded-tile bg-canvas-soft p-4">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-canvas">
              <Icon name="shield-check" size={17} />
            </span>
            <div>
              <p class="text-[14px] font-heading leading-tight">{review.panel.okTitle}</p>
              <p class="mt-1 text-[11px] leading-relaxed text-muted">{review.panel.okCopy}</p>
            </div>
          </div>
          <div class="mt-4 space-y-1.5">
            {
              review.panel.checks.map((label) => (
                <div class="flex items-center justify-between rounded-full px-3 py-2 text-[11px] odd:bg-canvas-soft">
                  <span class="text-muted">{label}</span>
                  <span class="inline-flex items-center gap-1 font-heading text-ink">
                    <Icon name="check" size={11} />
                    {review.panel.matches}
                  </span>
                </div>
              ))
            }
          </div>
          <p class="mt-4 flex items-start gap-1.5 text-[10px] leading-relaxed text-faint">
            <Icon name="info" size={11} class="mt-0.5 shrink-0" />
            {review.panel.footnote}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page mt-20 md:mt-28">
    <div class="grid gap-9 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:gap-12">
      <div>
        <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
          {delivery.eyebrow}
        </p>
        <h2 class="mt-4 text-h2">{delivery.title}</h2>
        <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-muted">
          {delivery.copy}
        </p>

        <div class="mt-7 space-y-4">
          {
            delivery.points.map((point) => (
              <div class="flex gap-3">
                <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full bg-canvas-soft">
                  <Icon name={point.icon as any} size={14} />
                </span>
                <div>
                  <p class="text-[14px] font-heading leading-tight">{point.title}</p>
                  <p class="mt-1 text-[12px] leading-relaxed text-muted">{point.copy}</p>
                </div>
              </div>
            ))
          }
        </div>

        <div class="mt-7">
          <Button href={localizePath(locale, '/#editor')} iconRight="arrow-right">
            {delivery.cta}
          </Button>
        </div>
      </div>

      <div class="overflow-hidden rounded-card border border-hairline-soft bg-canvas">
        <div class="flex items-center justify-between gap-3 border-b border-hairline-soft px-4 py-3">
          <div class="flex items-center gap-2">
            <span class="grid h-7 w-7 place-items-center rounded-full bg-canvas-soft">
              <Icon name="shrink" size={14} />
            </span>
            <span class="text-[11px] font-heading">{delivery.panel.title}</span>
          </div>
          <span class="rounded-full bg-canvas-soft px-2.5 py-1 text-[10px] text-muted">
            {delivery.panel.badge}
          </span>
        </div>
        <div class="p-4">
          <div class="flex flex-wrap items-start gap-x-8 gap-y-4">
            <div class="min-w-[190px] flex-1">
              <div class="flex items-baseline justify-between gap-3">
                <span class="text-[11px] font-heading text-ink">{delivery.panel.quality}</span>
                <span class="text-[11px] font-heading text-muted">
                  {delivery.panel.qualityValue}
                </span>
              </div>
              <div class="mt-3 h-1 w-full overflow-hidden rounded-full bg-hairline">
                <div class="h-full w-[60%] rounded-full bg-ink"></div>
              </div>
              <p class="mt-2.5 text-[10px] leading-relaxed text-muted">
                {delivery.panel.qualityNote}
              </p>
            </div>

            <div class="min-w-[160px]">
              <span class="text-[11px] font-heading text-ink">{delivery.panel.edge}</span>
              <div class="mt-2.5 flex h-9 items-center justify-between gap-2 rounded-full bg-canvas-soft px-3 text-[11px] font-heading text-ink">
                {delivery.panel.edgeValue}
                <Icon name="chevron-down" size={12} class="text-muted" />
              </div>
              <p class="mt-2 text-[10px] leading-relaxed text-muted">{delivery.panel.edgeNote}</p>
            </div>

            <div class="min-w-[180px]">
              <span class="text-[11px] font-heading text-ink">{delivery.panel.estimate}</span>
              <p class="mt-2.5 text-[11px] leading-snug text-muted">
                {delivery.panel.estimateValue}
              </p>
              <p class="mt-1 text-[11px] font-heading text-ink">{delivery.panel.estimateNote}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page mt-20 md:mt-28">
    <div class="grid gap-9 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-12">
      <div>
        <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
          {proof.eyebrow}
        </p>
        <h2 class="mt-4 text-h2">{proof.title}</h2>
        <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-muted">
          {proof.copy}
        </p>
        <div class="mt-6 flex flex-col gap-2 sm:flex-row">
          <Button
            dataAttrs={{
              'data-redactor-sample': '/samples/id.svg',
              'data-redactor-sample-name': 'Student ID',
            }}
            iconRight="arrow-right"
          >
            {proof.primaryCta}
          </Button>
          <Button
            href={localizePath(locale, '/guides/blur-vs-pixelate-vs-black-box')}
            variant="outline"
          >
            {proof.secondaryCta}
          </Button>
        </div>
      </div>
      <BeforeAfter locale={locale} />
    </div>
  </section>

  <section id="shortcuts" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <div class="grid gap-9 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
      <div class="self-start">
        <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
          {shortcuts.eyebrow}
        </p>
        <h2 class="mt-4 text-h2">{shortcuts.title}</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-muted">
          {shortcuts.copy}
        </p>
        <ul class="mt-6 space-y-3 text-[13px]">
          {
            shortcuts.points.map((point, index) => (
              <li class="flex items-center gap-2.5">
                <span class="grid h-6 w-6 place-items-center rounded-full bg-canvas-soft">
                  <Icon
                    name={(['keyboard', 'image', 'refresh'] as const)[index] ?? 'keyboard'}
                    size={12}
                  />
                </span>
                {point}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="overflow-hidden rounded-card border border-hairline-soft bg-canvas">
        <div class="border-b border-hairline-soft px-5 py-4">
          <h3 class="text-[14px] font-heading">{shortcuts.panelTitle}</h3>
        </div>
        <dl class="divide-y divide-hairline-soft">
          {
            shortcuts.list.map((shortcut) => (
              <div class="flex items-center justify-between gap-4 px-5 py-3">
                <dt class="text-[12px] text-muted">{shortcut.action}</dt>
                <dd>
                  <kbd class="rounded-full bg-canvas-soft px-2.5 py-1 font-sans text-[10px] font-heading text-ink">
                    {shortcut.keys}
                  </kbd>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="container-page mt-20 md:mt-28">
    <div class="rounded-panel bg-canvas-soft p-5 md:p-10 lg:p-12">
      <SectionHead eyebrow={limits.eyebrow} title={limits.title} copy={limits.copy} />
      <div class="mt-8 grid gap-3 sm:grid-cols-2">
        {
          limits.items.map((limit) => (
            <div class="rounded-tile bg-canvas p-5">
              <span class="inline-flex rounded-full bg-canvas-soft px-2.5 py-1 text-[10px] font-heading leading-none text-muted">
                {limit.badge}
              </span>
              <h3 class="mt-3 text-[16px] leading-tight">{limit.title}</h3>
              <p class="mt-2 text-[12px] leading-relaxed text-muted">{limit.copy}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-5 flex items-start gap-2 text-[11px] leading-relaxed text-muted">
        <Icon name="info" size={12} class="mt-0.5 shrink-0" />
        {limits.footnote}
      </p>
    </div>
  </section>

  <CtaBand
    class="mt-20 md:mt-28"
    eyebrow={cta.eyebrow}
    title={cta.title}
    copy={cta.copy}
    cta={cta.primary}
    href={localizePath(locale, '/#editor')}
    secondary={cta.secondary}
    secondaryHref={localizePath(locale, cta.secondaryHref ?? '/guides')}
    locale={locale}
  />
</BaseLayout>
