---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import GuideCard from '../GuideCard.astro';
import CtaBand from '../CtaBand.astro';
import type { Locale } from '../../i18n/config';
import { LOCALES, localizePath } from '../../i18n/config';
import { getGuidesIndexContent } from '../../i18n/content/guides-index';
import { getGuides } from '../../i18n/content/guides';

interface Props {
  locale: Locale;
  availableLocales?: Locale[];
}

const { locale, availableLocales = LOCALES } = Astro.props;
const content = getGuidesIndexContent(locale);
const { meta, hero, latestLabel, readGuide, allGuidesEyebrow, allGuidesTitle, allGuidesCopy, rule, cta } =
  content;
const guides = getGuides(locale);
const [featured, ...rest] = guides;
const featuredHref = localizePath(locale, `/guides/${featured.slug}`);
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  ogImageAlt={meta.title}
  locale={locale}
  availableLocales={availableLocales}
  splash
>
  <PageHero eyebrow={hero.eyebrow} title={hero.title} lead={hero.lead}>
    <Button slot="actions" href={localizePath(locale, '/#editor')} size="lg" iconRight="arrow-right">
      {hero.primaryCta}
    </Button>
    <Button slot="actions" href="#latest" variant="outline" size="lg">{hero.secondaryCta}</Button>
  </PageHero>

  <section id="latest" class="container-page scroll-mt-28">
    <div class="grid overflow-hidden rounded-panel border border-hairline-soft bg-canvas lg:grid-cols-2">
      <a href={featuredHref} class="group order-1 block overflow-hidden bg-canvas-soft lg:order-1">
        <img
          src={featured.cover}
          width="1200"
          height="800"
          alt={featured.coverAlt}
          class="aspect-[4/3] h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.02] lg:aspect-auto"
          decoding="async"
        />
      </a>
      <div class="order-2 flex flex-col justify-center p-6 md:p-10 lg:order-2">
        <p class="flex items-center gap-2 text-[11px] font-heading leading-none text-muted">
          <span class="rounded-full bg-canvas-soft px-2.5 py-1">{latestLabel}</span>
          <span>{featured.readingTime}</span>
        </p>
        <h2 class="mt-4 text-h3">
          <a href={featuredHref} class="hover:underline hover:decoration-1 hover:underline-offset-4">
            {featured.title}
          </a>
        </h2>
        <p class="mt-3 text-[14px] leading-relaxed text-muted">{featured.description}</p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <Button href={featuredHref} iconRight="arrow-right">{readGuide}</Button>
          <span class="inline-flex items-center gap-1.5 text-[11px] text-faint">
            <Icon name="clock" size={12} />
            {featured.category}
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page mt-20 md:mt-28">
    <div class="flex flex-col justify-between gap-4 border-b border-hairline-soft pb-5 sm:flex-row sm:items-end">
      <div>
        <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
          {allGuidesEyebrow}
        </p>
        <h2 class="mt-3 text-h3">{allGuidesTitle}</h2>
      </div>
      <p class="max-w-xs text-[12px] leading-relaxed text-muted">
        {allGuidesCopy}
      </p>
    </div>

    <div class="mt-6 grid gap-3 md:grid-cols-2">
      {
        rest.map((guide) => (
          <GuideCard guide={guide} locale={locale} readLabel={readGuide} />
        ))
      }
    </div>
  </section>

  <section class="container-page mt-20 md:mt-28">
    <div class="grid gap-8 rounded-panel bg-canvas-soft p-6 md:grid-cols-[auto_1fr] md:p-10">
      <div class="flex h-14 w-14 items-center justify-center rounded-full bg-canvas">
        <Icon name="clock" size={22} />
      </div>
      <div>
        <h2 class="text-h3">{rule.title}</h2>
        <p class="mt-3 max-w-2xl text-[14px] leading-relaxed text-muted">
          {rule.copy}
        </p>
        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          {
            rule.questions.map((item) => (
              <div class="rounded-tile bg-canvas p-4">
                <p class="text-[13px] font-heading leading-tight">{item.question}</p>
                <p class="mt-2 text-[11px] leading-relaxed text-muted">{item.copy}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    class="mt-20 md:mt-28"
    eyebrow={cta.eyebrow}
    title={cta.title}
    copy={cta.copy}
    cta={cta.primary}
    href={localizePath(locale, '/#editor')}
    secondary={cta.secondary}
    secondaryHref={localizePath(locale, cta.secondaryHref ?? '/privacy')}
    locale={locale}
  />
</BaseLayout>
