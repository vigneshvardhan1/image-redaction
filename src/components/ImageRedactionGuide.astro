---
import Button from './Button.astro';
import Icon from './Icon.astro';
import type { Locale } from '../i18n/config';
import { localizePath } from '../i18n/config';
import type { HomeContent } from '../i18n/content/types';
import { t } from '../i18n/ui';
import { hasGuide } from '../i18n/content/guides';

interface Props {
  locale: Locale;
  guide: HomeContent['guide'];
}

const { locale, guide } = Astro.props;
const relatedLinks = guide.relatedLinks.filter((link) => hasGuide(locale, link.slug));
const linkClass =
  'font-heading text-ink underline decoration-hairline underline-offset-4 transition-colors hover:decoration-ink';
---

<section
  id="image-redaction"
  class="container-page mt-20 scroll-mt-28 md:mt-28"
  aria-labelledby="image-redaction-title"
>
  <div class="grid gap-10 lg:grid-cols-[0.78fr_1.22fr] lg:gap-16">
    <div class="self-start lg:sticky lg:top-28">
      <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
        {guide.eyebrow}
      </p>
      <h2 id="image-redaction-title" class="mt-4 text-h2">
        {guide.title}
      </h2>
      <p class="mt-4 max-w-md text-[15px] leading-relaxed text-muted">
        {guide.lead}
      </p>

      <nav aria-label={t(locale, 'guide.inThisGuide')} class="mt-7 hidden lg:block">
        <p class="text-[11px] font-heading text-muted">{t(locale, 'guide.inThisGuide')}</p>
        <ol class="mt-3 space-y-2.5">
          {
            guide.sections.map((section, index) => (
              <li class="flex gap-2.5">
                <span class="mt-0.5 text-[10px] font-heading text-faint">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <a
                  href={`#${section.id}`}
                  class="text-[12px] leading-snug text-muted transition-colors hover:text-ink"
                >
                  {section.navLabel}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="mt-7 hidden lg:block">
        <Button
          href={localizePath(locale, '/#editor')}
          variant="soft"
          size="sm"
          iconRight="arrow-right"
        >
          {guide.cta}
        </Button>
      </div>
    </div>

    <article class="max-w-2xl">
      <p class="text-[18px] font-light leading-[1.6] text-ink">{guide.intro}</p>

      <div class="mt-9">
        {
          guide.sections.map((section) => (
            <div>
              <h3 id={section.id} class="mt-10 scroll-mt-28 text-[22px] leading-tight first:mt-0">
                {section.title}
              </h3>
              {section.paragraphs.map((paragraph) => (
                <p class="mt-4 text-[15.5px] leading-[1.75] text-ink-soft">{paragraph}</p>
              ))}
              {section.bullets && section.bullets.length > 0 && (
                <ul class="mt-5 space-y-2.5">
                  {section.bullets.map((bullet) => (
                    <li class="flex gap-2.5 text-[15px] leading-[1.65] text-ink-soft">
                      <span class="mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-ink" aria-hidden="true" />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }

        <p class="mt-8 text-[15.5px] leading-[1.75] text-ink-soft">
          {t(locale, 'guide.eachHasOwnGuide')}
        </p>
        <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-[14px]">
          {
            guide.relatedLinks.filter((link) => hasGuide(locale, link.slug)).map((link) => (
              <a href={localizePath(locale, `/guides/${link.slug}`)} class={linkClass}>
                {link.label}
              </a>
            ))
          }
        </p>
        <p class="mt-4 flex items-start gap-2 text-[15px] leading-[1.65] text-ink-soft">
          <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-canvas-soft">
            <Icon name="check" size={11} />
          </span>
          <span>{guide.closing}</span>
        </p>
      </div>
    </article>
  </div>
</section>
