---
import Icon from './Icon.astro';
import { comparisonRows } from '../data/comparison';
---

<div class="overflow-hidden rounded-card border border-hairline-soft bg-canvas">
  <div class="hidden lg:block">
    <table class="w-full min-w-[780px] border-collapse text-left">
      <caption class="sr-only">
        How Image Redaction compares with typical web tools and desktop apps
      </caption>
      <thead>
        <tr class="border-b border-hairline-soft">
          <th scope="col" class="w-[32%] px-5 py-4 text-[11px] font-heading text-muted">
            Capability
          </th>
          <th scope="col" class="border-x border-hairline-soft bg-canvas-soft px-5 py-4">
            <span class="flex items-center gap-2 text-[12px] font-heading text-ink">
              Image Redaction
              <span class="rounded-full bg-ink px-2 py-0.5 text-[9px] font-heading leading-none text-white">
                This site
              </span>
            </span>
          </th>
          <th scope="col" class="px-5 py-4 text-[12px] font-heading text-muted">
            Typical web tool
          </th>
          <th scope="col" class="px-5 py-4 text-[12px] font-heading text-muted">
            Desktop app
          </th>
        </tr>
      </thead>
      <tbody>
        {
          comparisonRows.map((row) => (
            <tr class="border-b border-hairline-soft last:border-b-0">
              <th scope="row" class="px-5 py-3.5 align-top text-[13px] font-body text-ink">
                {row.feature}
                {row.note && (
                  <span class="mt-1 block text-[11px] font-normal leading-snug text-faint">
                    {row.note}
                  </span>
                )}
              </th>
              <td class="border-x border-hairline-soft bg-canvas-soft px-5 py-3.5 align-top">
                <span class="inline-flex items-start gap-1.5 text-[13px] font-heading text-ink">
                  <Icon name="check" size={13} class="mt-0.5 shrink-0" />
                  {row.ours}
                </span>
              </td>
              <td class="px-5 py-3.5 align-top text-[13px] text-muted">{row.web}</td>
              <td class="px-5 py-3.5 align-top text-[13px] text-muted">{row.desktop}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="lg:hidden">
    <div class="flex items-center justify-between gap-3 border-b border-hairline-soft bg-canvas-soft px-4 py-3">
      <span class="flex items-center gap-2 text-[11px] font-heading">
        Image Redaction
        <span class="rounded-full bg-ink px-2 py-0.5 text-[9px] leading-none text-white">This site</span>
      </span>
      <span class="text-[10px] text-muted">vs. typical tools</span>
    </div>
    <div class="divide-y divide-hairline-soft">
      {
        comparisonRows.map((row) => (
          <div class="p-4">
            <p class="text-[13px] font-heading leading-snug">{row.feature}</p>
            {row.note && <p class="mt-1 text-[10px] leading-snug text-faint">{row.note}</p>}
            <div class="mt-3 grid grid-cols-3 gap-1.5">
              <div class="rounded-[10px] bg-canvas-soft p-2.5">
                <p class="text-[9px] font-heading text-muted">This site</p>
                <p class="mt-1 flex items-start gap-1 text-[11px] font-heading leading-tight text-ink">
                  <Icon name="check" size={11} class="mt-0.5 shrink-0" />
                  {row.ours}
                </p>
              </div>
              <div class="p-2.5">
                <p class="text-[9px] text-faint">Web tool</p>
                <p class="mt-1 text-[11px] leading-tight text-muted">{row.web}</p>
              </div>
              <div class="p-2.5">
                <p class="text-[9px] text-faint">Desktop</p>
                <p class="mt-1 text-[11px] leading-tight text-muted">{row.desktop}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<div class="mt-3 flex flex-col gap-1 px-1 text-[11px] leading-relaxed text-faint sm:flex-row sm:items-center sm:justify-between">
  <p>Categories, not specific products. Features vary by tool, plan, and version.</p>
  <p class="inline-flex items-center gap-1.5">
    <Icon name="info" size={12} />
    Verify anything that matters before you rely on it.
  </p>
</div>
