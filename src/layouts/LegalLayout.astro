---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';

interface TocItem {
  id: string;
  label: string;
}

interface Highlight {
  value: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  updated: string;
  toc: TocItem[];
  summary?: string;
  highlights?: Highlight[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  eyebrow = 'Legal',
  updated,
  toc,
  summary,
  highlights = [],
  schema,
} = Astro.props;
---

<BaseLayout title={`${title} — Redact`} description={description} schema={schema}>
  <PageHero eyebrow={eyebrow} title={title} lead={description} />

  <section class="container-page">
    <div class="grid gap-8 lg:grid-cols-[230px_minmax(0,1fr)] lg:gap-14">
      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-card border border-hairline-soft bg-canvas p-4">
          <p class="flex items-center gap-2 px-2 text-[11px] font-heading leading-none text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
            On this page
          </p>
          <nav
            class="mt-3 grid grid-cols-2 gap-x-2 gap-y-0.5 lg:grid-cols-1"
            aria-label="On this page"
          >
            {
              toc.map((item) => (
                <a
                  href={`#${item.id}`}
                  class="rounded-full px-2 py-1.5 text-[12px] leading-snug text-muted transition-colors hover:bg-canvas-soft hover:text-ink"
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <p class="mt-4 border-t border-hairline-soft px-2 pt-3 text-[11px] leading-relaxed text-faint">
            Last updated
            <span class="mt-0.5 block font-heading text-muted">{updated}</span>
          </p>
        </div>
      </aside>

      <div class="min-w-0">
        {
          highlights.length > 0 && (
            <div class="grid gap-px overflow-hidden rounded-card border border-hairline-soft bg-hairline-soft sm:grid-cols-3">
              {highlights.map((item) => (
                <div class="bg-canvas px-4 py-4">
                  <p class="text-[17px] font-heading leading-none">{item.value}</p>
                  <p class="mt-1.5 text-[11px] leading-snug text-muted">{item.label}</p>
                </div>
              ))}
            </div>
          )
        }

        {
          summary && (
            <p class="mt-3 rounded-tile bg-canvas-soft px-4 py-3.5 text-[13px] leading-relaxed text-muted">
              <span class="font-heading text-ink">The short version. </span>
              {summary}
            </p>
          )
        }

        <article class="legal-prose mt-9 max-w-[46rem]">
          <slot />
        </article>

        <div class="mt-10 flex max-w-[46rem] flex-col gap-4 rounded-card border border-hairline-soft bg-canvas p-5 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-[14px] font-heading leading-tight">Still have a question?</p>
            <p class="mt-1 text-[12px] leading-relaxed text-muted">
              Email <a href="mailto:hello@imageredaction.com" class="underline decoration-hairline underline-offset-2 hover:decoration-ink">hello@imageredaction.com</a>{' '}
              or use the contact page.
            </p>
          </div>
          <div class="flex shrink-0 flex-col gap-2 sm:flex-row">
            <Button href="/contact" size="md" iconRight="arrow-right">Contact us</Button>
            <Button href="/privacy" variant="outline" size="md">
              <span class="inline-flex items-center gap-2">
                <Icon name="shield" size={14} />
                How privacy works
              </span>
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
