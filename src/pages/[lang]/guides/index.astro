---
import GuidesIndexPage from '../../../components/pages/GuidesIndexPage.astro';
import type { Locale } from '../../../i18n/config';
import { LOCALIZED_LOCALES } from '../../../i18n/config';

export function getStaticPaths() {
  return LOCALIZED_LOCALES.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<GuidesIndexPage locale={locale} />
