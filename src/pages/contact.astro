---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';

const channels = [
  {
    icon: 'mail' as const,
    title: 'Email us',
    copy: 'The fastest route. One inbox, read by a person.',
    value: 'hello@imageredaction.com',
  },
  {
    icon: 'clock' as const,
    title: 'What to expect',
    copy: 'Replies usually take a day or two. There is no ticket number and no guaranteed response time.',
    value: 'No chatbot',
  },
  {
    icon: 'shield' as const,
    title: 'Privacy or security',
    copy: 'Put “Privacy” in the subject and include the request you saw. Never attach a real sensitive image.',
    value: 'Reports welcome',
  },
];

const beforeYouWrite = [
  {
    icon: 'alert' as const,
    title: 'Bug reports',
    copy: 'Tell us the browser, what you did, what happened, and what you expected. A redacted screenshot helps — redact it first.',
  },
  {
    icon: 'shield' as const,
    title: 'Privacy questions',
    copy: 'Describe the request you saw in the Network tab and what looked wrong. A synthetic sample is enough to reproduce most issues.',
  },
  {
    icon: 'sparkles' as const,
    title: 'Feature requests',
    copy: 'Describe the job you are trying to finish, not only the button you want. It is easier to build the right thing from the problem.',
  },
];

const quickLinks = [
  {
    title: 'Frequently asked questions',
    copy: 'Uploads, file formats, OCR, metadata, and the one cookie.',
    href: '/#faq',
    icon: 'info' as const,
  },
  {
    title: 'Guides',
    copy: 'Practical notes on IDs, receipts, chats, dashboards, and redaction styles.',
    href: '/guides',
    icon: 'file' as const,
  },
  {
    title: 'Privacy notes',
    copy: 'The data flow, every network request, and how to verify both.',
    href: '/privacy',
    icon: 'shield' as const,
  },
  {
    title: 'Terms & Conditions',
    copy: 'The rules for using the tool, including its limits.',
    href: '/terms',
    icon: 'layout' as const,
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Redact',
  url: 'https://imageredaction.com/contact',
  description:
    'Contact the team behind Redact about bugs, privacy questions, feature requests, or anything else.',
  mainEntity: {
    '@type': 'Organization',
    name: 'Redact',
    url: 'https://imageredaction.com/',
    email: 'hello@imageredaction.com',
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: 'hello@imageredaction.com',
      availableLanguage: 'English',
    },
  },
};
---

<BaseLayout
  title="Contact — Redact"
  description="Email the team behind Redact about a bug, a privacy question, or a feature request. No ticket portal, no chatbot — just one inbox."
  schema={schema}
>
  <PageHero
    eyebrow="Contact"
    title="Tell us what broke, or what is missing."
    lead="Questions, bug reports, privacy concerns, and feature requests all land in the same inbox. No ticket portal, no chatbot, no account required."
  >
    <Button slot="actions" href="#write" size="lg" iconRight="arrow-right">Write a message</Button>
    <Button slot="actions" href="mailto:hello@imageredaction.com" variant="outline" size="lg" iconRight="arrow-up-right">
      Email us directly
    </Button>
  </PageHero>

  <section class="container-page">
    <div class="grid gap-3 md:grid-cols-3">
      {
        channels.map((channel) => (
          <div class="rounded-card border border-hairline-soft bg-canvas p-5">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-canvas-soft">
              <Icon name={channel.icon} size={16} />
            </span>
            <h2 class="mt-4 text-[16px] leading-tight">{channel.title}</h2>
            <p class="mt-1.5 text-[12px] leading-relaxed text-muted">{channel.copy}</p>
            <p class="mt-3 text-[12px] font-heading text-ink">{channel.value}</p>
            {channel.title === 'Email us' && (
              <div class="mt-3 flex flex-wrap items-center gap-2">
                <Button
                  variant="soft"
                  size="sm"
                  iconLeft="copy"
                  ariaLabel="Copy email address"
                  dataAttrs={{ 'data-copy-email': 'hello@imageredaction.com' }}
                >
                  Copy address
                </Button>
                <span data-copy-status role="status" aria-live="polite" class="text-[11px] text-muted"></span>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section id="write" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <div class="grid gap-9 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
      <div>
        <SectionHead
          eyebrow="Write to us"
          title="One inbox, read by a person."
          copy="Use the form to prepare a message in your own email app. Nothing is transmitted from this page, and no draft is stored here."
        />

        <ul class="mt-7 space-y-4 text-[13px] text-muted">
          <li class="flex gap-3">
            <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-canvas-soft">
              <Icon name="lock" size={12} />
            </span>
            <span>The form builds a <code class="rounded bg-canvas-soft px-1.5 py-0.5 font-mono text-[11px] text-ink">mailto:</code> link. Your message is sent only when you press send in your email app.</span>
          </li>
          <li class="flex gap-3">
            <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-canvas-soft">
              <Icon name="image" size={12} />
            </span>
            <span>Please do not attach real images containing sensitive data. A synthetic sample or a redacted screenshot is enough.</span>
          </li>
          <li class="flex gap-3">
            <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-canvas-soft">
              <Icon name="clock" size={12} />
            </span>
            <span>Replies are written by a human. Expect a day or two, not an instant response.</span>
          </li>
        </ul>

        <p class="mt-7 rounded-tile bg-canvas-soft p-4 text-[12px] leading-relaxed text-muted">
          No email app on this device? Write to{' '}
          <a href="mailto:hello@imageredaction.com" class="font-heading text-ink underline decoration-hairline underline-offset-2 hover:decoration-ink">hello@imageredaction.com</a>{' '}
          directly.
        </p>
      </div>

      <div class="rounded-panel border border-hairline-soft bg-canvas p-5 md:p-8">
        <form id="contact-form" class="space-y-4" novalidate>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="text-[12px] font-heading text-ink">Name</span>
              <input
                type="text"
                name="name"
                autocomplete="name"
                placeholder="Your name"
                class="design-field mt-2 h-11 w-full px-4 text-[14px]"
              />
            </label>
            <label class="block">
              <span class="text-[12px] font-heading text-ink">Email <span class="text-faint">(required)</span></span>
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
                class="design-field mt-2 h-11 w-full px-4 text-[14px]"
              />
            </label>
          </div>

          <label class="block">
            <span class="text-[12px] font-heading text-ink">Topic</span>
            <select name="topic" class="design-field mt-2 h-11 w-full px-4 text-[14px]">
              <option>General question</option>
              <option>Bug report</option>
              <option>Privacy or security</option>
              <option>Feature request</option>
              <option>Something else</option>
            </select>
          </label>

          <label class="block">
            <span class="text-[12px] font-heading text-ink">Message <span class="text-faint">(required)</span></span>
            <textarea
              name="message"
              rows="6"
              required
              placeholder="What happened, what did you expect, and which browser were you using?"
              class="design-field mt-2 w-full px-4 py-3 text-[14px] leading-relaxed"
            ></textarea>
          </label>

          <div class="flex flex-col gap-3 pt-1 sm:flex-row sm:items-center sm:justify-between">
            <p class="max-w-xs text-[11px] leading-relaxed text-muted">
              This form opens your email app. Nothing is sent from this page.
            </p>
            <Button type="submit" iconRight="arrow-up-right">Open email draft</Button>
          </div>

          <p data-form-status role="status" aria-live="polite" class="min-h-[1em] text-[12px] leading-relaxed text-muted"></p>
        </form>
      </div>
    </div>
  </section>

  <section class="container-page mt-20 md:mt-28">
    <SectionHead
      eyebrow="Before you write"
      title="A few details make the reply faster."
      copy="There is no form to route, so the first message is the whole ticket. These three notes cover most of the back-and-forth."
    />
    <div class="mt-8 grid gap-3 md:grid-cols-3">
      {
        beforeYouWrite.map((item) => (
          <article class="rounded-card border border-hairline-soft bg-canvas p-5">
            <span class="grid h-8 w-8 place-items-center rounded-full bg-canvas-soft">
              <Icon name={item.icon} size={14} />
            </span>
            <h2 class="mt-4 text-[15px] leading-tight">{item.title}</h2>
            <p class="mt-2 text-[12px] leading-relaxed text-muted">{item.copy}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container-page mt-20 md:mt-28">
    <div class="rounded-panel bg-canvas-soft p-6 md:p-10 lg:p-12">
      <div class="grid gap-9 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
        <div>
          <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
            Answers first
          </p>
          <h2 class="mt-4 text-h2">Some questions do not need an email.</h2>
          <p class="mt-4 max-w-md text-[14px] leading-relaxed text-muted">
            The FAQ and the privacy notes cover the common ones: file formats, OCR,
            cookies, metadata, and what happens to the image. If your answer is there,
            you can skip the wait.
          </p>
          <div class="mt-6">
            <Button href="/#editor" iconRight="arrow-right">Open the editor</Button>
          </div>
        </div>

        <div class="grid gap-2 sm:grid-cols-2">
          {
            quickLinks.map((link) => (
              <a
                href={link.href}
                class="group flex min-h-11 flex-col rounded-tile bg-canvas p-4 transition-colors hover:bg-field"
              >
                <span class="flex items-center justify-between gap-3">
                  <span class="grid h-7 w-7 place-items-center rounded-full bg-canvas-soft">
                    <Icon name={link.icon} size={13} />
                  </span>
                  <Icon name="arrow-up-right" size={13} class="text-faint transition-colors group-hover:text-ink" />
                </span>
                <span class="mt-3 text-[13px] font-heading leading-tight">{link.title}</span>
                <span class="mt-1 text-[11px] leading-relaxed text-muted">{link.copy}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const formStatus = document.querySelector<HTMLElement>('[data-form-status]');

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const topic = String(data.get('topic') ?? 'General question');
      const message = String(data.get('message') ?? '').trim();

      const subject = `${topic} — ${name || 'Website message'}`;
      const bodyLines: string[] = [];
      if (name) bodyLines.push(`Name: ${name}`);
      bodyLines.push(`Email: ${email}`, '', message, '', 'Sent from the Redact contact page');
      const body = bodyLines.join('\n');

      if (formStatus) formStatus.textContent = 'Opening your email app…';

      window.location.href = `mailto:hello@imageredaction.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });

    const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
    const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');
    const email = copyButton?.dataset.copyEmail ?? 'hello@imageredaction.com';

    async function copyText(text: string) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        const field = document.createElement('textarea');
        field.value = text;
        field.setAttribute('readonly', '');
        field.style.position = 'fixed';
        field.style.opacity = '0';
        document.body.appendChild(field);
        field.select();
        let copied = false;
        try {
          copied = document.execCommand('copy');
        } catch {
          copied = false;
        }
        field.remove();
        return copied;
      }
    }

    copyButton?.addEventListener('click', async () => {
      const copied = await copyText(email);
      if (!copyStatus) return;
      copyStatus.textContent = copied ? 'Copied' : 'Copy failed — select the address instead.';
      window.setTimeout(() => {
        copyStatus.textContent = '';
      }, 2500);
    });
  </script>
</BaseLayout>
