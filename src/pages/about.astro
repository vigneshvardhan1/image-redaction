---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';

const stats = [
  { value: '0', label: 'Images uploaded' },
  { value: '0', label: 'Accounts required' },
  { value: '0', label: 'Trackers or analytics' },
  { value: '100%', label: 'Processing in your browser' },
];

const principles = [
  {
    icon: 'monitor' as const,
    title: 'Local by default',
    copy: 'If a feature can run in the tab, it does. There is no upload endpoint, no processing queue, and no temporary bucket to trust.',
  },
  {
    icon: 'alert' as const,
    title: 'Honest about limits',
    copy: 'Faces, QR codes, and unusual names still need a manual box. A clean verification scan is evidence, not a guarantee.',
  },
  {
    icon: 'chat' as const,
    title: 'Plain language',
    copy: 'Privacy and legal pages should be readable without a translator. Where a term is unavoidable, it gets an explanation.',
  },
  {
    icon: 'shield' as const,
    title: 'No account, no profile',
    copy: 'No sign-in, no email wall, no usage history. The editor does not know who you are, and there is nothing to export about you.',
  },
  {
    icon: 'zap' as const,
    title: 'Free without a catch',
    copy: 'No watermark, no export credit, no paid upgrade for the safe option. Ink black — the strongest style — costs nothing.',
  },
  {
    icon: 'code' as const,
    title: 'Inspectable claims',
    copy: 'The Network tab is the receipt. The privacy page explains exactly what to check and what you should see when you check it.',
  },
];

const steps = [
  {
    number: '01',
    title: 'Drop or paste a file',
    copy: 'The browser reads the image locally. PNG, JPG, WebP, GIF, BMP, and AVIF are supported.',
    icon: 'image' as const,
  },
  {
    number: '02',
    title: 'Cover what matters',
    copy: 'Smart detect suggests likely PII. Draw over faces, codes, and anything the scan misses. Ink is the default.',
    icon: 'square' as const,
  },
  {
    number: '03',
    title: 'Verify and export',
    copy: 'Re-scan the flattened image, compare it with the original, then download a metadata-free PNG, JPG, or WebP.',
    icon: 'shield-check' as const,
  },
];

const stack = [
  {
    label: 'Astro',
    value: 'Static pages and components',
  },
  {
    label: 'Canvas API',
    value: 'Local decoding, redaction, and export',
  },
  {
    label: 'Tesseract.js',
    value: 'Optional OCR in a Web Worker',
  },
  {
    label: 'Inter',
    value: 'Self-hosted type, served from this site',
  },
];

const notList = [
  {
    title: 'Not a compliance certificate',
    copy: 'A redacted image does not prove that a document meets a privacy law, a court order, or an internal policy.',
  },
  {
    title: 'Not legal advice',
    copy: 'The guides explain practical redaction. They are not a substitute for a lawyer or a data protection officer.',
  },
  {
    title: 'Not a full image editor',
    copy: 'There are no layers, text annotations, or batch exports yet. It is a focused tool for covering things.',
  },
  {
    title: 'Not infallible',
    copy: 'OCR is best-effort, and a box only covers what it covers. Always look at the exported file before sharing it.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Redact',
  url: 'https://imageredaction.com/about',
  description:
    'Redact is a free, browser-based image redaction tool built so sensitive screenshots never have to be uploaded to be protected.',
  mainEntity: {
    '@type': 'Organization',
    name: 'Redact',
    url: 'https://imageredaction.com/',
    email: 'hello@imageredaction.com',
    description:
      'A browser-based redaction studio for screenshots, IDs, receipts, and other images containing sensitive details.',
  },
};
---

<BaseLayout
  title="About — Redact"
  description="Why Redact exists: a free, browser-based redaction tool built so the screenshot you are trying to protect never has to be uploaded to protect it."
  schema={schema}
>
  <PageHero
    eyebrow="About"
    title="Built so you can share less."
    lead="Redact is a free, browser-based redaction studio built on one rule: the file you are trying to protect should not be uploaded in order to protect it."
  >
    <Button slot="actions" href="/#editor" size="lg" iconRight="arrow-right">Open the editor</Button>
    <Button slot="actions" href="/contact" variant="outline" size="lg">Contact us</Button>
  </PageHero>

  <section class="container-page">
    <div class="grid gap-px overflow-hidden rounded-card border border-hairline-soft bg-hairline-soft sm:grid-cols-2 lg:grid-cols-4">
      {
        stats.map((stat) => (
          <div class="bg-canvas px-5 py-5">
            <p class="text-[28px] font-heading leading-none">{stat.value}</p>
            <p class="mt-2 text-[11px] leading-snug text-muted">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container-page mt-20 md:mt-28">
    <div class="grid gap-9 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div>
        <SectionHead eyebrow="Why it exists" title="The upload step was the problem." />
      </div>
      <div class="max-w-2xl space-y-4 text-[15px] leading-relaxed text-muted md:text-[16px]">
        <p>
          Screenshots are how work gets explained now — a support thread, a receipt, an
          ID, a dashboard, a chat with a delivery address in it. The detail that makes
          the screenshot useful is often the same detail that should not travel with it.
        </p>
        <p>
          Most redaction tools start by asking you to upload the exact file you are
          trying to protect. That never sat right. A tool that removes sensitive details
          should not collect them first, and a promise to delete the copy tomorrow is
          still a copy today.
        </p>
        <p>
          Redact flips the order. Your browser decodes the image, draws it to a local
          canvas, and bakes the redactions into a new file. There is no upload endpoint.
          Smart detection downloads an OCR engine and an English model, but your image
          is not part of that request.
        </p>
        <p class="font-heading text-ink">
          We are not anti-cloud. We are against the unnecessary step in the middle. When
          the browser can do the job, the safest place for the file is the place it
          already is.
        </p>
      </div>
    </div>
  </section>

  <section class="container-page mt-20 md:mt-28">
    <SectionHead
      eyebrow="Principles"
      title="The rules the product is built on."
      copy="These are not aspirations on a wall. They decide what gets shipped, what gets disclosed, and what gets left out."
    />
    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        principles.map((principle) => (
          <article class="rounded-card border border-hairline-soft bg-canvas p-5">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-canvas-soft">
              <Icon name={principle.icon} size={16} />
            </span>
            <h2 class="mt-4 text-[17px] leading-tight">{principle.title}</h2>
            <p class="mt-2 text-[13px] leading-relaxed text-muted">{principle.copy}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container-page mt-20 md:mt-28">
    <div class="rounded-panel bg-canvas-soft p-6 md:p-10 lg:p-12">
      <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
        <div>
          <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
            How it works
          </p>
          <h2 class="mt-4 text-h2">Three steps, none of them a server.</h2>
          <p class="mt-4 text-[14px] leading-relaxed text-muted">
            The whole workflow fits in one tab. The only optional download is the OCR
            engine used by Smart detect.
          </p>
          <div class="mt-6">
            <Button href="/privacy" variant="outline" iconRight="arrow-right">
              See the data flow
            </Button>
          </div>
        </div>

        <ol class="space-y-3">
          {
            steps.map((step) => (
              <li class="flex gap-4 rounded-tile bg-canvas p-4 md:p-5">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-canvas-soft">
                  <Icon name={step.icon} size={15} />
                </span>
                <div>
                  <p class="text-[11px] font-heading leading-none text-faint">{step.number}</p>
                  <p class="mt-1.5 text-[15px] font-heading leading-tight">{step.title}</p>
                  <p class="mt-1.5 text-[12px] leading-relaxed text-muted">{step.copy}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="container-page mt-20 md:mt-28">
    <div class="grid gap-9 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
          Under the hood
        </p>
        <h2 class="mt-4 text-h2">Small stack. No hidden service.</h2>
        <p class="mt-4 max-w-lg text-[15px] leading-relaxed text-muted">
          The site is static HTML, CSS, and JavaScript. There is no backend that receives
          images, no analytics SDK, and no advertising code. The pieces that do the work
          are ordinary web APIs and open-source software.
        </p>
        <p class="mt-4 max-w-lg text-[12px] leading-relaxed text-faint">
          Smart detection is the one feature that needs a network request after the page
          loads. It fetches Tesseract.js and language data; the image stays in the tab.
        </p>
      </div>

      <dl class="grid gap-3 sm:grid-cols-2">
        {
          stack.map((item) => (
            <div class="rounded-card border border-hairline-soft bg-canvas p-5">
              <dt class="text-[14px] font-heading leading-tight">{item.label}</dt>
              <dd class="mt-1.5 text-[12px] leading-relaxed text-muted">{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="container-page mt-20 md:mt-28">
    <div class="grid gap-9 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <SectionHead eyebrow="Honest limits" title="What Redact is not." />
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {
          notList.map((item) => (
            <div class="rounded-tile bg-canvas-soft p-5">
              <h3 class="text-[15px] leading-tight">{item.title}</h3>
              <p class="mt-2 text-[12px] leading-relaxed text-muted">{item.copy}</p>
            </div>
          ))
        }
      </div>
    </div>
    <p class="mt-5 flex items-start gap-2 text-[11px] leading-relaxed text-muted">
      <Icon name="info" size={12} class="mt-0.5 shrink-0" />
      Those limits are the reason verification and a final visual check are part of the
      workflow, not an optional extra.
    </p>
  </section>

  <CtaBand
    class="mt-20 md:mt-28"
    eyebrow="Use it for what it is"
    title="Share the screenshot. Not the secrets."
    copy="The editor is free, local, and open to inspection. Load an image, cover what should not travel with it, and check the export before you send it."
    secondary="Talk to us"
    secondaryHref="/contact"
  />
</BaseLayout>
