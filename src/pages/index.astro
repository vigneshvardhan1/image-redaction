---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Redactor from '../components/Redactor.astro';
import SectionHead from '../components/SectionHead.astro';
import DetectionShowcase from '../components/DetectionShowcase.astro';
import ModeDemos from '../components/ModeDemos.astro';
import RedactionTour from '../components/RedactionTour.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import GuideCard from '../components/GuideCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { homeFaqs } from '../data/faq';
import { guidesByDate } from '../data/guides';

const useCases = [
  {
    title: 'Chats & messages',
    copy: 'Names, emails, phone numbers, and delivery details tucked into message bubbles.',
    image: '/samples/chat-redacted.svg',
    alt: 'A chat screenshot with black bars covering a name, email address, phone number, address, and card expiry.',
    sample: '/samples/chat.svg',
    sampleName: 'Chat screenshot',
    icon: 'chat' as const,
  },
  {
    title: 'IDs & documents',
    copy: 'Photos, dates of birth, ID numbers, addresses, and machine-readable codes.',
    image: '/samples/id-redacted.svg',
    alt: 'A student ID card with black bars covering the photo, name, date of birth, ID number, address, barcode, and QR code.',
    sample: '/samples/id.svg',
    sampleName: 'Student ID',
    icon: 'id-card' as const,
  },
  {
    title: 'Receipts & banking',
    copy: 'Card details, billing emails, order numbers, tax IDs, and support contacts.',
    image: '/samples/receipt-redacted.svg',
    alt: 'A receipt with black bars covering the order number, payment details, billing email, shipping address, tax ID, and support phone.',
    sample: '/samples/receipt.svg',
    sampleName: 'Receipt',
    icon: 'credit-card' as const,
  },
  {
    title: 'Work dashboards',
    copy: 'Signed-in accounts, customer tables, revenue figures, and internal URLs.',
    image: '/samples/dashboard-redacted.svg',
    alt: 'An analytics dashboard with black bars covering the account holder, customer names, email addresses, and revenue figures.',
    sample: '/samples/dashboard.svg',
    sampleName: 'Dashboard',
    icon: 'layout' as const,
  },
];

const detectionPoints = [
  'Finds emails, card numbers, phone numbers, IDs, addresses, and dates.',
  'Every box is a suggestion — include or exclude it before you redact.',
  'All text mode covers every detected line when you would rather not decide.',
  'Verify re-scans the flattened result for text that still looks sensitive.',
];

const privacyPoints = [
  {
    icon: 'monitor' as const,
    title: 'Your browser does the work',
    copy: 'The file is decoded into a canvas in this tab. There is no upload endpoint to send it to.',
  },
  {
    icon: 'image' as const,
    title: 'Exports are new images',
    copy: 'Canvas re-encoding leaves the original EXIF, GPS coordinates, and device details behind.',
  },
  {
    icon: 'globe' as const,
    title: 'The one request is disclosed',
    copy: 'Smart detection downloads Tesseract.js and an English model on first use. Your image is never part of that request. Manual redaction works without it.',
  },
];

const steps = [
  {
    number: '01',
    title: 'Drop or paste an image',
    copy: 'PNG, JPG, WebP, GIF, BMP, or AVIF. It opens locally — not on a server.',
    icon: 'image' as const,
  },
  {
    number: '02',
    title: 'Cover what should not travel',
    copy: 'Run Smart detect, then move, resize, or draw boxes. Use ink, pixelate, blur, or a sticker.',
    icon: 'cursor' as const,
  },
  {
    number: '03',
    title: 'Verify and download',
    copy: 'Re-scan the flattened result, then export PNG, JPG, or WebP with no metadata — and shrink it if the file is too heavy.',
    icon: 'shield-check' as const,
  },
];

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Image Redaction',
  url: 'https://imageredaction.com/',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any modern web browser',
  browserRequirements: 'Requires JavaScript. Smart detection downloads an OCR model on first use.',
  description:
    'Redact names, emails, card numbers, addresses, and other sensitive details from screenshots in your browser. On-device smart detection, four redaction styles, verification re-scan, and metadata-free exports.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  featureList: [
    'On-device OCR for sensitive text',
    'Ink black, pixelate, blur, and emoji redactions',
    'Rectangle and oval selections',
    'Undo, redo, move, and resize',
    'Verification re-scan',
    'Metadata-free PNG, JPG, and WebP exports',
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout description="Hide names, emails, card numbers, and addresses in screenshots. On-device smart detection, four redaction styles, and metadata-free exports. Free, no account, no uploads." schema={[appSchema, faqSchema]}>
  <section class="container-page pb-8 pt-14 md:pt-20">
    <div class="mx-auto max-w-4xl text-center">
      <a
        href="#detection"
        class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas px-3 py-1.5 text-[12px] leading-none transition-colors hover:bg-canvas-soft"
      >
        <Icon name="sparkles" size={13} class="text-muted" />
        <span class="font-heading">Smart detection, on your device</span>
        <Icon name="arrow-right" size={12} class="text-muted" />
      </a>

      <h1 class="mx-auto mt-6 max-w-4xl text-[2.55rem] leading-[1.02] text-balance sm:text-display sm:leading-[0.98]">
        Share the screenshot.<span class="block">Not the secrets.</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-[19px] font-light leading-relaxed text-muted md:text-[21px]">
        Hide names, emails, card numbers, and addresses in seconds. Smart detection
        runs inside your browser, and every export leaves its metadata behind.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-2 sm:flex-row">
        <Button href="#editor" size="lg" iconRight="arrow-right">Redact an image</Button>
        <Button href="#how-it-works" variant="outline" size="lg">See how it works</Button>
      </div>

      <p class="mt-5 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-[12px] text-muted">
        <span>Free</span>
        <span class="text-faint" aria-hidden="true">·</span>
        <span>No account</span>
        <span class="text-faint" aria-hidden="true">·</span>
        <span>No uploads</span>
        <span class="text-faint" aria-hidden="true">·</span>
        <span>No watermark</span>
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-[1080px] md:mt-14">
      <Redactor />
    </div>
  </section>

  <section class="container-page mt-12 md:mt-16" aria-label="Privacy and product facts">
    <div class="grid grid-cols-2 gap-px overflow-hidden rounded-card border border-hairline-soft bg-hairline-soft md:grid-cols-4">
      <div class="bg-canvas p-5">
        <span class="grid h-8 w-8 place-items-center rounded-full bg-canvas-soft">
          <Icon name="lock" size={15} />
        </span>
        <p class="mt-3 text-[13px] font-heading leading-tight">0 bytes uploaded</p>
        <p class="mt-1 text-[11px] leading-relaxed text-muted">No upload endpoint exists.</p>
      </div>
      <div class="bg-canvas p-5">
        <span class="grid h-8 w-8 place-items-center rounded-full bg-canvas-soft">
          <Icon name="shield" size={15} />
        </span>
        <p class="mt-3 text-[13px] font-heading leading-tight">Metadata removed</p>
        <p class="mt-1 text-[11px] leading-relaxed text-muted">EXIF and GPS don't travel with the export.</p>
      </div>
      <div class="bg-canvas p-5">
        <span class="grid h-8 w-8 place-items-center rounded-full bg-canvas-soft">
          <Icon name="zap" size={15} />
        </span>
        <p class="mt-3 text-[13px] font-heading leading-tight">Free, no account</p>
        <p class="mt-1 text-[11px] leading-relaxed text-muted">No email, no plan, no watermark.</p>
      </div>
      <div class="bg-canvas p-5">
        <span class="grid h-8 w-8 place-items-center rounded-full bg-canvas-soft">
          <Icon name="wifi-off" size={15} />
        </span>
        <p class="mt-3 text-[13px] font-heading leading-tight">Works offline</p>
        <p class="mt-1 text-[11px] leading-relaxed text-muted">Keep editing after the page loads.</p>
      </div>
    </div>
  </section>

  <section id="proof" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <div class="grid gap-9 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-12">
      <div>
        <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
          Proof, not promises
        </p>
        <h2 class="mt-4 text-h2">The black bar is the whole point.</h2>
        <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-muted">
          A redaction should be boring: opaque, flattened, and verified. There is no
          hidden layer to peel back in the file you download — whichever of the four
          styles you use.
        </p>

        <div class="mt-7 space-y-4">
          <div class="flex gap-3">
            <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full bg-canvas-soft">
              <Icon name="square" size={14} />
            </span>
            <div>
              <p class="text-[14px] font-heading leading-tight">Flattened, not layered</p>
              <p class="mt-1 text-[12px] leading-relaxed text-muted">
                The export is a new image. No hidden layer, no editable mask, no undo in the file.
              </p>
            </div>
          </div>
          <div class="flex gap-3">
            <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full bg-canvas-soft">
              <Icon name="shield-check" size={14} />
            </span>
            <div>
              <p class="text-[14px] font-heading leading-tight">Re-scan before sharing</p>
              <p class="mt-1 text-[12px] leading-relaxed text-muted">
                Verify reads the flattened image and flags text that still matches a sensitive pattern.
              </p>
            </div>
          </div>
          <div class="flex gap-3">
            <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full bg-canvas-soft">
              <Icon name="eye" size={14} />
            </span>
            <div>
              <p class="text-[14px] font-heading leading-tight">Inspect it at full size</p>
              <p class="mt-1 text-[12px] leading-relaxed text-muted">
                Step through all four styles in the sample, then drag the handle and
                look for text peeking out from behind a cover.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-7">
          <Button
            variant="outline"
            iconRight="arrow-right"
            dataAttrs={{
              'data-redactor-sample': '/samples/id.svg',
              'data-redactor-sample-name': 'Student ID',
            }}
          >
            Open the ID sample
          </Button>
        </div>
      </div>

      <RedactionTour />
    </div>
  </section>

  <section id="use-cases" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <SectionHead
      eyebrow="What people hide"
      title="Every screenshot has a small confession in it."
      copy="The obvious secret is rarely the only one. Pick the kind of image you are about to share and see what usually needs covering."
    />

    <div class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        useCases.map((useCase) => (
          <article class="group flex flex-col overflow-hidden rounded-card border border-hairline-soft bg-canvas">
            <div class="relative aspect-[3/2] overflow-hidden border-b border-hairline-soft bg-canvas-soft">
              <img
                src={useCase.image}
                width="1200"
                height="800"
                alt={useCase.alt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.02]"
              />
              <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-heading leading-none text-overlay-ink backdrop-blur-sm">
                <Icon name="lock" size={10} />
                Redacted
              </span>
            </div>
            <div class="flex flex-1 flex-col p-5">
              <div class="flex items-center gap-2.5">
                <span class="grid h-8 w-8 place-items-center rounded-full bg-canvas-soft">
                  <Icon name={useCase.icon} size={15} />
                </span>
                <h3 class="text-[19px] leading-tight">{useCase.title}</h3>
              </div>
              <p class="mt-3 text-[13px] leading-relaxed text-muted">{useCase.copy}</p>
              <button
                type="button"
                data-redactor-sample={useCase.sample}
                data-redactor-sample-name={useCase.sampleName}
                class="mt-5 inline-flex min-h-8 items-center gap-1.5 self-start text-[12px] font-heading text-ink hover:underline"
              >
                Open this sample
                <Icon name="arrow-up-right" size={12} />
              </button>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section id="detection" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <div class="rounded-panel bg-canvas-soft p-5 md:p-10 lg:p-12">
      <div class="grid gap-9 lg:grid-cols-[1fr_0.95fr] lg:items-center lg:gap-12">
        <div>
          <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
            Smart detection
          </p>
          <h2 class="mt-4 text-h2">Stop hunting for the sensitive bits.</h2>
          <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-muted">
            Smart detection reads the text already visible in your screenshot and
            suggests the lines that look like identifiers. It runs in a Web Worker
            on your device, so the image never leaves the page.
          </p>
          <ul class="mt-6 space-y-2.5">
            {
              detectionPoints.map((point) => (
                <li class="flex items-start gap-2.5 text-[13px] leading-relaxed text-ink">
                  <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-canvas">
                    <Icon name="check" size={11} />
                  </span>
                  {point}
                </li>
              ))
            }
          </ul>
          <div class="mt-7 flex flex-col gap-2 sm:flex-row">
            <Button href="#editor" iconRight="arrow-right">
              Try smart detection
            </Button>
            <Button href="/guides/how-to-redact-a-screenshot" variant="outline">
              Read the redaction guide
            </Button>
          </div>
        </div>

        <DetectionShowcase />
      </div>
    </div>
    <p class="mt-3 px-1 text-[11px] leading-relaxed text-faint">
      First use downloads the OCR engine and English model. The image is not part of that request.
    </p>
  </section>

  <section id="styles" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <SectionHead
      eyebrow="Redaction styles"
      title="Four ways to make something disappear."
      copy="Match the cover to the risk. The soft effects look better; the black box is the one to trust with money and identity."
    >
      <Button slot="actions" href="#editor" variant="soft" iconRight="arrow-up-right">
        Open the editor
      </Button>
    </SectionHead>
    <div class="mt-8">
      <ModeDemos />
    </div>
  </section>

  <section id="privacy" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <div class="rounded-panel bg-canvas-soft p-5 md:p-10 lg:p-12">
      <div class="grid gap-9 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
        <div>
          <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
            Privacy by architecture
          </p>
          <h2 class="mt-4 text-h2">There is nowhere for the image to go.</h2>
          <p class="mt-4 text-[16px] leading-relaxed text-muted">
            This is not a promise to delete your file after processing. The file is
            never sent in the first place. You can confirm it in the network tab.
          </p>
          <div class="mt-6">
            <Button href="/privacy" variant="soft" iconRight="arrow-up-right">
              Read the privacy notes
            </Button>
          </div>
        </div>

        <div class="divide-y divide-hairline">
          {
            privacyPoints.map((point) => (
              <div class="flex gap-4 py-5 first:pt-0 last:pb-0">
                <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full bg-canvas">
                  <Icon name={point.icon} size={16} />
                </span>
                <div>
                  <p class="text-[14px] font-heading leading-tight">{point.title}</p>
                  <p class="mt-1.5 text-[12px] leading-relaxed text-muted">{point.copy}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="compare" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <SectionHead
      eyebrow="Compare"
      title="A small tool with a clear boundary."
      copy="Categories, not specific products. The useful comparison is not the feature list — it is where your image goes."
    />
    <div class="mt-8">
      <ComparisonTable />
    </div>
  </section>

  <section id="how-it-works" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <SectionHead
      align="center"
      eyebrow="How it works"
      title="Three steps. No account screen in the middle."
      copy="Open the page, work on the image, take the file. That is the whole flow."
    />
    <div class="mt-10 grid gap-3 md:grid-cols-3">
      {
        steps.map((step) => (
          <div class="rounded-card bg-canvas-soft p-6">
            <div class="flex items-center justify-between">
              <span class="text-[38px] font-light leading-none text-faint">{step.number}</span>
              <span class="grid h-9 w-9 place-items-center rounded-full bg-canvas">
                <Icon name={step.icon} size={16} />
              </span>
            </div>
            <h3 class="mt-8 text-[19px] leading-tight">{step.title}</h3>
            <p class="mt-2 text-[13px] leading-relaxed text-muted">{step.copy}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-8 text-center">
      <Button href="#editor" iconRight="arrow-right">Start redacting</Button>
    </div>
  </section>

  <section id="guides" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <SectionHead
      eyebrow="Guides"
      title="A little paranoia, written down."
      copy="Short, practical notes on what to cover, which style to use, and how to check your own work."
    >
      <Button slot="actions" href="/guides" variant="soft" iconRight="arrow-up-right">
        All guides
      </Button>
    </SectionHead>
    <div class="mt-8 grid gap-3 md:grid-cols-3">
      {guidesByDate.slice(0, 3).map((guide) => <GuideCard guide={guide} />)}
    </div>
  </section>

  <section id="faq" class="container-page mt-20 scroll-mt-28 md:mt-28">
    <div class="grid gap-9 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
      <div class="self-start lg:sticky lg:top-28">
        <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
          FAQ
        </p>
        <h2 class="mt-4 text-h2">The questions people ask before trusting a redaction tool.</h2>
        <p class="mt-4 max-w-md text-[15px] leading-relaxed text-muted">
          If something is missing, ask. The answer will be added here rather than
          buried in a support inbox.
        </p>
        <a
          href="mailto:hello@imageredaction.com?subject=Image%20Redaction%20question"
          class="mt-5 inline-flex items-center gap-1.5 text-[13px] font-heading text-ink hover:underline"
        >
          Ask a question
          <Icon name="arrow-up-right" size={13} />
        </a>
      </div>
      <Faq items={homeFaqs} />
    </div>
  </section>

  <CtaBand class="mt-20 md:mt-28" />
</BaseLayout>
