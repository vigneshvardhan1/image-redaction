---
import ErrorPage from '../components/ErrorPage.astro';
import Button from '../components/Button.astro';

const links = [
  { label: 'Home', href: '/', icon: 'arrow-right' },
  { label: 'Redact an image', href: '/#editor', icon: 'image' },
  { label: 'Features', href: '/features', icon: 'sparkles' },
  { label: 'Privacy notes', href: '/privacy', icon: 'shield' },
  { label: 'Guides', href: '/guides', icon: 'file' },
  { label: 'FAQ', href: '/#faq', icon: 'info' },
];
---

<ErrorPage
  code="404"
  pageTitle="Page not found — Redact"
  description="This page does not exist. The editor, guides, and privacy notes are still here."
  heading="This page was redacted."
  lead="Either it never existed, or it was covered by an unusually large black box. The editor is still one click away."
  panelLabel="A surviving index"
  panelBadge="No dead ends"
  panelIcon="lock"
  links={links}
>
  <Button slot="actions" href="/#editor" size="lg" iconRight="arrow-right">Open the editor</Button>
  <Button slot="actions" href="/" variant="outline" size="lg">Back home</Button>
</ErrorPage>
