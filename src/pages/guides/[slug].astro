---
import GuidePage from '../../components/pages/GuidePage.astro';
import type { Guide } from '../../data/guides';
import type { Locale } from '../../i18n/config';
import { DEFAULT_LOCALE } from '../../i18n/config';
import { getGuideLocales, getGuides } from '../../i18n/content/guides';

export function getStaticPaths() {
  return getGuides(DEFAULT_LOCALE).map((guide) => ({
    params: { slug: guide.slug },
    props: {
      guide,
      availableLocales: getGuideLocales(guide.slug),
    },
  }));
}

interface Props {
  guide: Guide;
  availableLocales: Locale[];
}

const { guide, availableLocales } = Astro.props;
---

<GuidePage guide={guide} locale={DEFAULT_LOCALE} availableLocales={availableLocales} />
