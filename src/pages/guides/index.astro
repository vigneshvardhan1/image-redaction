---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import GuideCard from '../../components/GuideCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { guidesByDate } from '../../data/guides';

const [featured, ...rest] = guidesByDate;
---

<BaseLayout
  title="Guides — Redact"
  description="Practical guides to redacting screenshots, receipts, ID cards, and work dashboards. Learn which redaction style is safe and how to verify your own work."
>
  <PageHero
    eyebrow="Guides"
    title="Less sharing. More thinking."
    lead="Short, practical notes on what to cover, which style to trust, and how to check your own redaction before the image leaves your hands."
  >
    <Button slot="actions" href="/#editor" size="lg" iconRight="arrow-right">Open the editor</Button>
    <Button slot="actions" href="#latest" variant="outline" size="lg">Start with the latest</Button>
  </PageHero>

  <section id="latest" class="container-page scroll-mt-28">
    <div class="grid overflow-hidden rounded-panel border border-hairline-soft bg-canvas lg:grid-cols-2">
      <a href={`/guides/${featured.slug}`} class="group order-1 block overflow-hidden bg-canvas-soft lg:order-1">
        <img
          src={featured.cover}
          width="1200"
          height="800"
          alt={featured.coverAlt}
          class="aspect-[4/3] h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.02] lg:aspect-auto"
          decoding="async"
        />
      </a>
      <div class="order-2 flex flex-col justify-center p-6 md:p-10 lg:order-2">
        <p class="flex items-center gap-2 text-[11px] font-heading leading-none text-muted">
          <span class="rounded-full bg-canvas-soft px-2.5 py-1">Latest guide</span>
          <span>{featured.readingTime}</span>
        </p>
        <h2 class="mt-4 text-h3">
          <a href={`/guides/${featured.slug}`} class="hover:underline hover:decoration-1 hover:underline-offset-4">
            {featured.title}
          </a>
        </h2>
        <p class="mt-3 text-[14px] leading-relaxed text-muted">{featured.description}</p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <Button href={`/guides/${featured.slug}`} iconRight="arrow-right">Read the guide</Button>
          <span class="inline-flex items-center gap-1.5 text-[11px] text-faint">
            <Icon name="clock" size={12} />
            {featured.category}
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page mt-20 md:mt-28">
    <div class="flex flex-col justify-between gap-4 border-b border-hairline-soft pb-5 sm:flex-row sm:items-end">
      <div>
        <p class="flex items-center gap-2 text-[12px] font-heading leading-none text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-ink" aria-hidden="true"></span>
          All guides
        </p>
        <h2 class="mt-3 text-h3">The rest of the field notes.</h2>
      </div>
      <p class="max-w-xs text-[12px] leading-relaxed text-muted">
        Written for people who would rather not learn about redaction the hard way.
      </p>
    </div>

    <div class="mt-6 grid gap-3 md:grid-cols-2">
      {rest.map((guide) => <GuideCard guide={guide} />)}
    </div>
  </section>

  <section class="container-page mt-20 md:mt-28">
    <div class="grid gap-8 rounded-panel bg-canvas-soft p-6 md:grid-cols-[auto_1fr] md:p-10">
      <div class="flex h-14 w-14 items-center justify-center rounded-full bg-canvas">
        <Icon name="clock" size={22} />
      </div>
      <div>
        <h2 class="text-h3">The 60-second rule.</h2>
        <p class="mt-3 max-w-2xl text-[14px] leading-relaxed text-muted">
          If you would not read the detail aloud in a crowded room, cover it before
          the screenshot leaves your device. Three questions make the decision easier:
        </p>
        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          {
            [
              ['Could this identify a person?', 'Name, photo, handle, email, phone, address, ID number.'],
              ['Could this cost money?', 'Card number, expiry, CVV, bank details, invoice number.'],
              ['Could this unlock an account?', 'Order number, date of birth, tax ID, security answer.'],
            ].map(([question, copy]) => (
              <div class="rounded-tile bg-canvas p-4">
                <p class="text-[13px] font-heading leading-tight">{question}</p>
                <p class="mt-2 text-[11px] leading-relaxed text-muted">{copy}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    class="mt-20 md:mt-28"
    eyebrow="Put it into practice"
    title="Read less. Redact something."
    copy="The editor is free and local. Load a sample, cover a few details, and verify the result before you download it."
  />
</BaseLayout>
