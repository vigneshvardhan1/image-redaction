# Google AdSense (optional)
#
# Leave PUBLIC_ADSENSE_CLIENT blank to build a site with no advertising code,
# no consent banner, no ad units, and no ads.txt entry.
#
# Use the publisher ID from AdSense → Account → Settings, then create display
# ad units and paste their slot IDs below. The site loads AdSense with Consent
# Mode v2 defaults set to denied and only grants ad storage after a visitor
# accepts the banner.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_HOME=
PUBLIC_ADSENSE_SLOT_ARTICLE=
PUBLIC_ADSENSE_SLOT_TOOL=
